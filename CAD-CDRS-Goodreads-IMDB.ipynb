        "            f\"{movies.iloc[idx]['Genre']}\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Movie Rating     : \"\n",
        "            f\"{movies.iloc[idx]['Rating']}\"\n",
        "        )\n",
        "\n",
        "        print(\"-\" * 80)\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 9.2 — TEST TARGET PREDICTION\n",
        "# =========================================================\n",
        "\n",
        "predict_target_scores(\n",
        "\n",
        "    book_title=\"Harry Potter\",\n",
