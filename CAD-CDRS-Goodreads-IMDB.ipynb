      "source": [
        "# =========================================================\n",
        "# STEP 8.4 — CONFIDENCE-GUIDED REVERSE DIFFUSION\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Reverse Diffusion (Denoising)\n",
        "\n",
        "Equation:\n",
        "\n",
        "z_(u,i)^(t-1)\n",
        "\n",
        "=\n",
        "f_theta(\n",
        "\n",
        "    z_(u,i)^(t),\n",
        "\n",
        "    c_(u,i),\n",
        "\n",
        "    e_i^T,\n",
        "\n",
        "    t\n",
        "\n",
        ")\n",
        "\n",
        "Goal:\n",
        "\n",
        "Learn clean representation\n",
        "aligned with target domain\n",
        "using:\n",
        "\n",
        "✔ noisy embedding\n",
        "✔ confidence score\n",
        "✔ target item context\n",
        "✔ timestep conditioning\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# DENOISING NETWORK\n",
        "# =========================================================\n",
        "\n",
        "class ReverseDiffusionNetwork(nn.Module):\n",
        "\n",
        "    def __init__(self, embedding_dim):\n",
        "\n",
        "        super().__init__()\n",
        "\n",
        "        input_dim = (\n",
        "\n",
        "            embedding_dim     # noisy embedding\n",
        "\n",
        "            +\n",
        "\n",
        "            embedding_dim     # target movie context\n",
        "\n",
        "            +\n",
        "\n",
        "            1                 # confidence\n",
        "\n",
        "            +\n",
        "\n",
        "            1                 # timestep\n",
        "\n",
        "        )\n",
        "\n",
        "        self.network = nn.Sequential(\n",
        "\n",
        "            nn.Linear(\n",
        "                input_dim,\n",
        "                512\n",
        "            ),\n",
        "\n",
        "            nn.LayerNorm(512),\n",
        "\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Dropout(0.1),\n",
        "\n",
        "            nn.Linear(\n",
        "                512,\n",
        "                256\n",
        "            ),\n",
        "\n",
        "            nn.LayerNorm(256),\n",
        "\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Dropout(0.1),\n",
        "\n",
        "            nn.Linear(\n",
        "                256,\n",
        "                embedding_dim\n",
        "            )\n",
        "\n",
        "        )\n",
        "\n",
        "    def forward(\n",
        "\n",
        "        self,\n",
        "\n",
        "        noisy_embedding,\n",
        "\n",
        "        confidence_score,\n",
        "\n",
        "        target_context,\n",
        "\n",
        "        timestep\n",
        "\n",
        "    ):\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # normalize timestep\n",
        "        # -----------------------------------------\n",
        "\n",
        "        timestep = (\n",
        "\n",
        "            timestep.float()\n",
        "            .unsqueeze(1)\n",
        "        )\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # concatenate conditioning\n",
        "        # -----------------------------------------\n",
        "\n",
        "        x = torch.cat(\n",
        "\n",
        "            [\n",
        "\n",
        "                noisy_embedding,\n",
        "\n",
        "                target_context,\n",
        "\n",
        "                confidence_score,\n",
        "\n",
        "                timestep\n",
        "\n",
        "            ],\n",
        "\n",
        "            dim=1\n",
        "\n",
        "        )\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # predict clean embedding\n",
        "        # -----------------------------------------\n",
        "\n",
        "        reconstructed_embedding = self.network(x)\n",
        "\n",
        "        return reconstructed_embedding\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# INITIALIZE MODEL\n",
        "# =========================================================\n",
        "\n",
        "denoising_model = ReverseDiffusionNetwork(\n",
        "\n",
        "    EMBEDDING_DIM\n",
        "\n",
        ").to(device)\n",
        "\n",
        "print(\"\\nReverse diffusion network initialized!\")"
      ]
    },
