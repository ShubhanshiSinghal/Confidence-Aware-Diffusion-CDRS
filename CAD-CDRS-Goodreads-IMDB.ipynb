          "text": [
            "\n",
            "Confidence feature generation completed!\n",
            "Confidence Feature Shape : (54301, 5)\n",
            "Memory Usage (MB): 1.04\n",
            "\n",
            "Signals Generated:\n",
            "c1 → Interaction Overlap\n",
            "c2 → Preference Stability\n",
            "c3 → Embedding Alignment\n",
            "c4 → Genre Domain Gap\n",
            "c5 → Item Semantic Similarity\n"
          ]
        }
      ],
      "source": [
        "# =========================================================\n",
        "# STEP 7.6 — GENERATE MULTI-SIGNAL CONFIDENCE FEATURES\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Confidence Signals\n",
        "\n",
        "c1 → interaction overlap confidence\n",
        "c2 → preference stability confidence\n",
        "c3 → embedding alignment confidence\n",
        "c4 → genre domain-gap confidence\n",
        "c5 → item-level semantic similarity confidence\n",
        "\n",
        "Optimizations:\n",
        "\n",
        "✔ No full similarity matrix\n",
        "✔ Top-K retrieval only\n",
        "✔ No repeated DataFrame lookups\n",
        "✔ Reduced memory footprint\n",
        "✔ Faster execution\n",
        "✔ c3 and c5 use different embedding spaces\n",
        "\"\"\"\n",
        "\n",
        "print(\"\\nGenerating multi-signal confidence features...\\n\")\n",
        "\n",
        "confidence_features = []\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# NORMALIZE EMBEDDINGS\n",
        "# =========================================================\n",
        "\n",
        "book_embeddings = normalize(\n",
        "    book_embeddings\n",
        ")\n",
        "\n",
        "movie_embeddings = normalize(\n",
        "    movie_embeddings\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# CACHE DATAFRAME COLUMNS\n",
        "# =========================================================\n",
        "\n",
        "book_genres = books['genres'].values\n",
        "\n",
        "book_texts = books['combined_text'].values\n",
        "\n",
        "movie_genres = movies['Genre'].values\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# TOP-K MOVIE RETRIEVAL\n",
        "# =========================================================\n",
        "\n",
        "def get_top_k_movies(\n",
        "\n",
        "    book_embedding,\n",
        "\n",
        "    k=5\n",
        "\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    Memory-efficient retrieval\n",
        "\n",
        "    Avoids creating:\n",
        "\n",
        "    [num_books × num_movies]\n",
        "\n",
        "    similarity matrix\n",
        "    \"\"\"\n",
        "\n",
        "    scores = np.dot(\n",
        "\n",
        "        movie_embeddings,\n",
        "\n",
        "        book_embedding\n",
        "\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # top-k retrieval\n",
        "    # -----------------------------------------\n",
        "\n",
        "    top_indices = np.argpartition(\n",
        "\n",
        "        scores,\n",
        "\n",
        "        -k\n",
        "\n",
        "    )[-k:]\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # sort descending\n",
        "    # -----------------------------------------\n",
        "\n",
        "    top_indices = top_indices[\n",
        "\n",
        "        np.argsort(\n",
        "\n",
        "            scores[top_indices]\n",
        "\n",
        "        )[::-1]\n",
        "\n",
        "    ]\n",
        "\n",
        "    return top_indices\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# GENERATE CONFIDENCE FEATURES\n",
        "# =========================================================\n",
        "\n",
        "TOP_K = 5\n",
        "\n",
        "for i in tqdm(\n",
        "\n",
        "    range(len(book_embeddings)),\n",
        "\n",
        "    desc=\"Confidence Signals\"\n",
        "\n",
        "):\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # current book information\n",
        "    # -----------------------------------------\n",
        "\n",
        "    current_book_genres = (\n",
        "        book_genres[i]\n",
        "    )\n",
        "\n",
        "    current_book_text = (\n",
        "        book_texts[i]\n",
        "    )\n",
        "\n",
        "    # =====================================================\n",
        "    # TOP-K MOVIE MATCHES\n",
        "    # =====================================================\n",
        "\n",
        "    top_k_indices = get_top_k_movies(\n",
        "\n",
        "        book_embeddings[i],\n",
        "\n",
        "        TOP_K\n",
        "\n",
        "    )\n",
        "\n",
        "    # =====================================================\n",
        "    # AGGREGATED SIGNAL STORAGE\n",
        "    # =====================================================\n",
        "\n",
        "    c1_scores = []\n",
        "\n",
        "    c3_scores = []\n",
        "\n",
        "    c4_scores = []\n",
        "\n",
        "    c5_scores = []\n",
        "\n",
        "    # =====================================================\n",
        "    # MULTI-MOVIE CONFIDENCE AGGREGATION\n",
        "    # =====================================================\n",
        "\n",
        "    for movie_idx in top_k_indices:\n",
        "\n",
        "        current_movie_genres = (\n",
        "            movie_genres[movie_idx]\n",
        "        )\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # c1 Interaction Overlap\n",
        "        # -----------------------------------------\n",
        "\n",
        "        c1_scores.append(\n",
        "\n",
        "            interaction_overlap_confidence(\n",
        "\n",
        "                current_book_genres,\n",
        "\n",
        "                current_movie_genres\n",
        "\n",
        "            )\n",
        "\n",
        "        )\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # c3 Embedding Alignment\n",
        "        # (normalized embeddings)\n",
        "        # -----------------------------------------\n",
        "\n",
        "        c3_scores.append(\n",
        "\n",
        "            embedding_similarity_confidence(\n",
        "\n",
        "                book_embeddings[i],\n",
        "\n",
        "                movie_embeddings[movie_idx]\n",
        "\n",
        "            )\n",
        "\n",
        "        )\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # c4 Genre Domain Gap\n",
        "        # -----------------------------------------\n",
        "\n",
        "        c4_scores.append(\n",
        "\n",
        "            genre_distance_confidence(\n",
        "\n",
        "                current_book_genres,\n",
        "\n",
        "                current_movie_genres\n",
        "\n",
        "            )\n",
        "\n",
        "        )\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # c5 Item Similarity\n",
        "        #\n",
        "        # IMPORTANT:\n",
        "        # use ORIGINAL embeddings\n",
        "        # not normalized embeddings\n",
        "        #\n",
        "        # avoids duplication with c3\n",
        "        # -----------------------------------------\n",
        "\n",
        "        c5_scores.append(\n",
        "\n",
        "            item_similarity_confidence(\n",
        "\n",
        "                original_book_embeddings[i],\n",
        "\n",
        "                original_movie_embeddings[movie_idx]\n",
        "\n",
        "            )\n",
        "\n",
        "        )\n",
        "\n",
        "    # =====================================================\n",
        "    # AGGREGATED SIGNALS\n",
        "    # =====================================================\n",
        "\n",
        "    c1 = np.float32(\n",
        "        np.mean(c1_scores)\n",
        "    )\n",
        "\n",
        "    c3 = np.float32(\n",
        "        np.mean(c3_scores)\n",
        "    )\n",
        "\n",
        "    c4 = np.float32(\n",
        "        np.mean(c4_scores)\n",
        "    )\n",
        "\n",
        "    c5 = np.float32(\n",
        "        np.mean(c5_scores)\n",
        "    )\n",
        "\n",
        "    # =====================================================\n",
        "    # c2 Preference Stability\n",
        "    #\n",
        "    # use full combined text\n",
        "    # =====================================================\n",
        "\n",
        "    c2 = np.float32(\n",
        "\n",
        "        preference_entropy_confidence(\n",
        "\n",
        "            current_book_text\n",
        "\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "    # =====================================================\n",
        "    # STORE FEATURES\n",
        "    # =====================================================\n",
        "\n",
        "    confidence_features.append(\n",
        "\n",
        "        [\n",
        "\n",
        "            c1,  # interaction overlap\n",
        "\n",
        "            c2,  # preference stability\n",
        "\n",
        "            c3,  # embedding alignment\n",
        "\n",
        "            c4,  # genre domain gap\n",
        "\n",
        "            c5   # item semantic similarity\n",
        "\n",
        "        ]\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# CONVERT TO NUMPY\n",
        "# =========================================================\n",
        "\n",
        "confidence_features = np.asarray(\n",
        "\n",
        "    confidence_features,\n",
        "\n",
        "    dtype=np.float32\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# DISPLAY RESULTS\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nConfidence feature generation completed!\")\n",
        "\n",
        "print(\n",
        "    f\"Confidence Feature Shape : \"\n",
        "    f\"{confidence_features.shape}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Memory Usage (MB): \"\n",
        "    f\"{confidence_features.nbytes / (1024**2):.2f}\"\n",
        ")\n",
        "\n",
        "print(\"\\nSignals Generated:\")\n",
        "\n",
        "print(\"c1 → Interaction Overlap\")\n",
        "\n",
        "print(\"c2 → Preference Stability\")\n",
        "\n",
        "print(\"c3 → Embedding Alignment\")\n",
        "\n",
        "print(\"c4 → Genre Domain Gap\")\n",
        "\n",
        "print(\"c5 → Item Semantic Similarity\")"
      ]
    },
