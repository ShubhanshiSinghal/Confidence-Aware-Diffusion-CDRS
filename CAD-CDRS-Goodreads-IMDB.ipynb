        "# =========================================================\n",
        "# STEP 8.1 — CONFIDENCE-GATED FORWARD DIFFUSION\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Confidence-Gated Forward Diffusion\n",
        "\n",
        "Equation:\n",
        "\n",
        "z_(u,i)^(t)\n",
        "\n",
        "=\n",
        "\n",
        "sqrt(alpha_t * c_(u,i))\n",
        "*\n",
        "e_u^S\n",
        "\n",
        "+\n",
        "\n",
        "sqrt(1 - alpha_t * c_(u,i))\n",
        "*\n",
        "epsilon\n",
        "\n",
        "where:\n",
        "\n",
        "z_(u,i)^(t)\n",
        "=\n",
        "noisy user-item representation\n",
        "\n",
        "alpha_t\n",
        "=\n",
        "diffusion timestep coefficient\n",
        "\n",
        "c_(u,i)\n",
        "=\n",
        "multi-signal confidence score\n",
        "\n",
        "e_u^S\n",
        "=\n",
        "source-domain embedding\n",
        "\n",
        "epsilon\n",
        "=\n",
        "Gaussian noise\n",
        "\n",
        "Interpretation:\n",
        "\n",
        "High confidence:\n",
        "    preserve semantic signal\n",
        "\n",
        "Low confidence:\n",
        "    inject stronger noise\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 8.1.1 — DEVICE CONFIGURATION\n",
        "# =========================================================\n",
        "\n",
        "device = torch.device(\n",
        "\n",
        "    \"cuda\"\n",
        "\n",
        "    if torch.cuda.is_available()\n",
        "\n",
        "    else\n",
        "\n",
        "    \"cpu\"\n",
        "\n",
        ")\n",
        "\n",
        "print(f\"\\nUsing Device : {device}\")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 8.1.2 — SOURCE EMBEDDING TENSOR\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Source-domain embeddings\n",
        "\n",
        "e_u^S\n",
        "\"\"\"\n",
        "\n",
        "book_tensor = torch.tensor(\n",
        "\n",
        "    book_embeddings,\n",
        "\n",
        "    dtype=torch.float32\n",
        "\n",
        ").to(device)\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 8.1.3 — CONFIDENCE TENSOR\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Confidence tensor\n",
        "\n",
        "c_(u,i)\n",
        "\"\"\"\n",
        "\n",
        "confidence_tensor = torch.tensor(\n",
        "\n",
        "    final_confidence_scores,\n",
        "\n",
        "    dtype=torch.float32\n",
        "\n",
        ").unsqueeze(1).to(device)\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 8.1.4 — DIFFUSION TIMESTEPS\n",
        "# =========================================================\n",
        "\n",
        "T = 10\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 8.1.5 — DIFFUSION SCHEDULE\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "alpha_t schedule\n",
        "\n",
        "Controls signal preservation\n",
        "across timesteps.\n",
        "\"\"\"\n",
        "\n",
        "alpha_schedule = np.linspace(\n",
        "\n",
        "    0.95,\n",
        "\n",
        "    0.50,\n",
        "\n",
        "    T\n",
        "\n",
        ")\n",
        "\n",
        "alpha_schedule = torch.tensor(\n",
        "\n",
        "    alpha_schedule,\n",
        "\n",
        "    dtype=torch.float32\n",
        "\n",
        ").to(device)\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 8.1.6 — CONFIDENCE-GATED FORWARD DIFFUSION\n",
        "# =========================================================\n",
        "\n",
        "def confidence_gated_forward_diffusion(\n",
        "\n",
        "    source_embedding,\n",
        "    confidence_score,\n",
        "    timestep\n",
        "\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    Confidence-gated\n",
        "    forward diffusion\n",
        "\n",
        "    z_(u,i)^(t)\n",
        "\n",
        "    =\n",
        "\n",
        "    sqrt(alpha_t * c_(u,i))\n",
        "    *\n",
        "    e_u^S\n",
        "\n",
        "    +\n",
        "\n",
        "    sqrt(1 - alpha_t * c_(u,i))\n",
        "    *\n",
        "    epsilon\n",
        "    \"\"\"\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # timestep coefficient\n",
        "    # -----------------------------------------\n",
        "\n",
        "    alpha_t = alpha_schedule[\n",
        "        timestep\n",
        "    ]\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # confidence-weighted alpha\n",
        "    # -----------------------------------------\n",
        "\n",
        "    gated_alpha = (\n",
        "\n",
        "        alpha_t\n",
        "        *\n",
        "        confidence_score\n",
        "\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # numerical stability\n",
        "    # -----------------------------------------\n",
        "\n",
        "    gated_alpha = torch.clamp(\n",
        "\n",
        "        gated_alpha,\n",
        "\n",
        "        min=1e-5,\n",
        "\n",
        "        max=0.9999\n",
        "\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # Gaussian noise\n",
        "    # -----------------------------------------\n",
        "\n",
        "    epsilon = torch.randn_like(\n",
        "        source_embedding\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # signal preservation term\n",
        "    # -----------------------------------------\n",
        "\n",
        "    signal_component = (\n",
        "\n",
        "        torch.sqrt(gated_alpha)\n",
        "        *\n",
        "        source_embedding\n",
        "\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # noise injection term\n",
        "    # -----------------------------------------\n",
        "\n",
        "    noise_component = (\n",
        "\n",
        "        torch.sqrt(\n",
        "            1 - gated_alpha\n",
        "        )\n",
        "        *\n",
        "        epsilon\n",
        "\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # noisy embedding\n",
        "    # -----------------------------------------\n",
        "\n",
        "    noisy_embedding = (\n",
        "\n",
        "        signal_component\n",
        "        +\n",
        "        noise_component\n",
        "\n",
        "    )\n",
        "\n",
        "    return noisy_embedding, epsilon\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 8.1.7 — TEST FORWARD DIFFUSION\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nTesting confidence-gated forward diffusion...\\n\")\n",
        "\n",
        "sample_embedding = book_tensor[0].unsqueeze(0)\n",
        "\n",
        "sample_confidence = confidence_tensor[0].unsqueeze(0)\n",
        "\n",
        "sample_timestep = 0\n",
        "\n",
        "z_t, epsilon = confidence_gated_forward_diffusion(\n",
        "\n",
        "    sample_embedding,\n",
        "\n",
        "    sample_confidence,\n",
        "\n",
        "    sample_timestep\n",
        "\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Noisy Embedding Shape : \"\n",
        "    f\"{z_t.shape}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Noise Shape           : \"\n",
        "    f\"{epsilon.shape}\"\n",
        ")\n",
        "\n",
        "print(\"\\nForward diffusion completed successfully!\")"
      ]
    },
