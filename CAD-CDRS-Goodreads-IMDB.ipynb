        "# =========================================================\n",
        "# STEP 13 — FINAL EVALUATION PIPELINE (OPTIMIZED)\n",
        "# =========================================================\n",
        "\n",
        "from sklearn.preprocessing import normalize\n",
        "from tqdm import tqdm\n",
        "import numpy as np\n",
        "import gc\n",
        "import torch\n",
        "\n",
        "print(\"\\nNormalizing embeddings...\\n\")\n",
        "\n",
        "final_transferred_embeddings = normalize(\n",
        "    final_transferred_embeddings\n",
        ").astype(np.float32)\n",
        "\n",
        "movie_embeddings = normalize(\n",
        "    movie_embeddings\n",
        ").astype(np.float32)\n",
        "\n",
        "# =========================================================\n",
        "# VALIDATION\n",
        "# =========================================================\n",
        "\n",
        "if 'original_book_embeddings' not in globals():\n",
        "\n",
        "    original_book_embeddings = (\n",
        "        book_embeddings.copy()\n",
        "    )\n",
        "\n",
        "if 'original_movie_embeddings' not in globals():\n",
        "\n",
        "    original_movie_embeddings = (\n",
        "        movie_embeddings.copy()\n",
        "    )\n",
        "\n",
        "# =========================================================\n",
        "# ADAPTIVE NOISE SCHEDULE\n",
        "# =========================================================\n",
        "\n",
        "adaptive_alpha_schedule = np.array(\n",
        "\n",
        "    [\n",
        "\n",
        "        1.0 - ((t + 1) / T)\n",
        "\n",
        "        for t in range(T)\n",
        "\n",
        "    ],\n",
        "\n",
        "    dtype=np.float32\n",
        "\n",
        ")\n",
        "\n",
        "# =========================================================\n",
        "# GROUND TRUTH GENERATION\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nCreating evaluation ground truth...\\n\")\n",
        "\n",
        "ground_truth_items = np.empty(\n",
        "\n",
        "    len(original_book_embeddings),\n",
        "\n",
        "    dtype=np.int32\n",
        "\n",
        ")\n",
        "\n",
        "for i in tqdm(\n",
        "\n",
        "    range(len(original_book_embeddings)),\n",
        "\n",
        "    desc=\"Ground Truth\"\n",
        "\n",
        "):\n",
        "\n",
        "    scores = np.dot(\n",
        "\n",
        "        original_movie_embeddings,\n",
        "\n",
        "        original_book_embeddings[i]\n",
        "\n",
        "    )\n",
        "\n",
        "    ground_truth_items[i] = np.argmax(\n",
        "        scores\n",
        "    )\n",
        "\n",
        "print(\n",
        "    f\"Ground Truth Shape : \"\n",
        "    f\"{ground_truth_items.shape}\"\n",
        ")\n",
        "\n",
        "# =========================================================\n",
        "# NDCG@K\n",
        "# =========================================================\n",
        "\n",
        "def ndcg_at_k(\n",
        "\n",
        "    predicted_scores,\n",
        "\n",
        "    ground_truth_idx,\n",
        "\n",
        "    k=10\n",
        "\n",
        "):\n",
        "\n",
        "    top_k = np.argpartition(\n",
        "\n",
        "        predicted_scores,\n",
        "\n",
        "        -k\n",
        "\n",
        "    )[-k:]\n",
        "\n",
        "    ranked_items = top_k[\n",
        "\n",
        "        np.argsort(\n",
        "\n",
        "            predicted_scores[top_k]\n",
        "\n",
        "        )[::-1]\n",
        "\n",
        "    ]\n",
        "\n",
        "    match = np.where(\n",
        "\n",
        "        ranked_items == ground_truth_idx\n",
        "\n",
        "    )[0]\n",
        "\n",
        "    if len(match) == 0:\n",
        "\n",
        "        return 0.0\n",
        "\n",
        "    return 1.0 / np.log2(\n",
        "        match[0] + 2\n",
        "    )\n",
        "\n",
        "# =========================================================\n",
        "# HIT RATIO\n",
        "# =========================================================\n",
        "\n",
        "def hit_ratio_at_k(\n",
        "\n",
        "    predicted_scores,\n",
        "\n",
        "    ground_truth_idx,\n",
        "\n",
        "    k=10\n",
        "\n",
        "):\n",
        "\n",
        "    top_k = np.argpartition(\n",
        "\n",
        "        predicted_scores,\n",
        "\n",
        "        -k\n",
        "\n",
        "    )[-k:]\n",
        "\n",
        "    return int(\n",
        "        ground_truth_idx in top_k\n",
        "    )\n",
        "\n",
        "# =========================================================\n",
        "# FAST MRR\n",
        "# =========================================================\n",
        "\n",
        "def mrr_score(\n",
        "\n",
        "    predicted_scores,\n",
        "\n",
        "    ground_truth_idx\n",
        "\n",
        "):\n",
        "\n",
        "    gt_score = predicted_scores[\n",
        "        ground_truth_idx\n",
        "    ]\n",
        "\n",
        "    rank = np.sum(\n",
        "\n",
        "        predicted_scores > gt_score\n",
        "\n",
        "    ) + 1\n",
        "\n",
        "    return 1.0 / rank\n",
        "\n",
        "# =========================================================\n",
        "# EVALUATION\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nEvaluating recommendation quality...\\n\")\n",
        "\n",
        "NDCG_scores = []\n",
        "\n",
        "HR_scores = []\n",
        "\n",
        "MRR_scores = []\n",
        "\n",
        "for i in tqdm(\n",
        "\n",
        "    range(\n",
        "\n",
        "        len(\n",
        "            final_transferred_embeddings\n",
        "        )\n",
        "\n",
        "    ),\n",
        "\n",
        "    desc=\"Evaluation\"\n",
        "\n",
        "):\n",
        "\n",
        "    scores = np.dot(\n",
        "\n",
        "        movie_embeddings,\n",
        "\n",
        "        final_transferred_embeddings[i]\n",
        "\n",
        "    )\n",
        "\n",
        "    ground_truth_idx = (\n",
        "        ground_truth_items[i]\n",
        "    )\n",
        "\n",
        "    NDCG_scores.append(\n",
        "\n",
        "        ndcg_at_k(\n",
        "\n",
        "            scores,\n",
        "\n",
        "            ground_truth_idx,\n",
        "\n",
        "            k=10\n",
        "\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "    HR_scores.append(\n",
        "\n",
        "        hit_ratio_at_k(\n",
        "\n",
        "            scores,\n",
        "\n",
        "            ground_truth_idx,\n",
        "\n",
        "            k=10\n",
        "\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "    MRR_scores.append(\n",
        "\n",
        "        mrr_score(\n",
        "\n",
        "            scores,\n",
        "\n",
        "            ground_truth_idx\n",
        "\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "# =========================================================\n",
        "# RESULTS\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "\n",
        "print(\n",
        "    \"FINAL RECOMMENDATION PERFORMANCE\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\n",
        "    f\"NDCG@10      : \"\n",
        "    f\"{np.mean(NDCG_scores):.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Hit Ratio@10 : \"\n",
        "    f\"{np.mean(HR_scores):.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"MRR          : \"\n",
        "    f\"{np.mean(MRR_scores):.4f}\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# =========================================================\n",
        "# CLEANUP\n",
        "# =========================================================\n",
        "\n",
        "gc.collect()\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "\n",
        "    torch.cuda.empty_cache()"
      ]
