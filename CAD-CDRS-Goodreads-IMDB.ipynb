      "source": [
        "# =========================================================\n",
        "# STEP 8.2 — DIFFUSION PARAMETERS\n",
        "# =========================================================\n",
        "\n",
        "T = 10\n",
        "\n",
        "alpha_schedule = np.linspace(\n",
        "    0.95,\n",
        "    0.50,\n",
        "    T\n",
        ")\n",
        "\n",
        "alpha_schedule = torch.tensor(\n",
        "    alpha_schedule,\n",
        "    dtype=torch.float32\n",
        ").to(device)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "4bsBGPU2UC65"
      },
      "outputs": [],
      "source": [
        "# =========================================================\n",
        "# STEP 8.3 — FORWARD DIFFUSION\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Add noise proportional to:\n",
        "(1 - confidence)\n",
        "\n",
        "High confidence:\n",
        "less noise\n",
        "\n",
        "Low confidence:\n",
        "more noise\n",
        "\"\"\"\n",
        "\n",
        "def forward_diffusion(\n",
        "    source_embedding,\n",
        "    confidence_score,\n",
        "    timestep,\n",
        "    min_alpha=0.15\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    Confidence-Gated Forward Diffusion\n",
        "\n",
        "    High confidence:\n",
        "        preserve semantic signal\n",
        "\n",
        "    Low confidence:\n",
        "        inject more noise\n",
        "        but preserve minimum structure\n",
        "\n",
        "    Equation:\n",
        "\n",
        "    effective_alpha =\n",
        "        (alpha_t * confidence)\n",
        "        +\n",
        "        ((1 - confidence) * min_alpha)\n",
        "    \"\"\"\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # diffusion timestep coefficient\n",
        "    # -----------------------------------------\n",
        "\n",
        "    alpha_t = alpha_schedule[timestep]\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # confidence-aware alpha\n",
        "    # -----------------------------------------\n",
        "\n",
        "    effective_alpha = (\n",
        "\n",
        "        (alpha_t * confidence_score)\n",
        "\n",
        "        +\n",
        "\n",
        "        (\n",
        "            (1 - confidence_score)\n",
        "            * min_alpha\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # numerical stability\n",
        "    # -----------------------------------------\n",
        "\n",
        "    effective_alpha = torch.clamp(\n",
        "        effective_alpha,\n",
        "        min=1e-5,\n",
        "        max=0.9999\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # gaussian noise\n",
        "    # -----------------------------------------\n",
        "\n",
        "    noise = torch.randn_like(\n",
        "        source_embedding\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # signal preservation\n",
        "    # -----------------------------------------\n",
        "\n",
        "    signal_weight = torch.sqrt(\n",
        "        effective_alpha\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # noise injection\n",
        "    # -----------------------------------------\n",
        "\n",
        "    noise_weight = torch.sqrt(\n",
        "        1 - effective_alpha\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # noisy embedding\n",
        "    # -----------------------------------------\n",
        "\n",
        "    noisy_embedding = (\n",
        "\n",
        "        signal_weight\n",
        "        * source_embedding\n",
        "\n",
        "        +\n",
        "\n",
        "        noise_weight\n",
        "        * noise\n",
        "\n",
        "    )\n",
        "\n",
        "    return noisy_embedding, noise"
      ]
    },
