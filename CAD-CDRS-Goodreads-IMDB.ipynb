        "# =========================================================\n",
        "# 7.1 USER-ITEM SEMANTIC INTERACTION OVERLAP\n",
        "# =========================================================\n",
        "\n",
        "def interaction_overlap_confidence(\n",
        "\n",
        "    source_item_genres,\n",
        "    target_item_genres\n",
        "\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    Semantic interaction overlap\n",
        "\n",
        "    Uses pairwise semantic similarity\n",
        "    between genres instead of\n",
        "    exact string matching.\n",
        "    \"\"\"\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # preprocess genres\n",
        "    # -----------------------------------------\n",
        "\n",
        "    source_set = list(\n",
        "        preprocess_genres(\n",
        "            source_item_genres\n",
        "        )\n",
        "    )\n",
        "\n",
        "    target_set = list(\n",
        "        preprocess_genres(\n",
        "            target_item_genres\n",
        "        )\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # empty protection\n",
        "    # -----------------------------------------\n",
        "\n",
        "    if len(source_set) == 0 or len(target_set) == 0:\n",
        "\n",
        "        return 0.0\n",
        "\n",
        "    semantic_matches = 0\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # semantic matching\n",
        "    # -----------------------------------------\n",
        "\n",
        "    for source_genre in source_set:\n",
        "\n",
        "        source_vector = genre_embedding(\n",
        "            source_genre\n",
        "        )\n",
        "\n",
        "        best_similarity = 0\n",
        "\n",
        "        for target_genre in target_set:\n",
        "\n",
        "            target_vector = genre_embedding(\n",
        "                target_genre\n",
        "            )\n",
        "\n",
        "            if np.all(source_vector == 0) or np.all(target_vector == 0):\n",
        "\n",
        "                continue\n",
        "\n",
        "            similarity = cosine_similarity(\n",
        "\n",
        "                [source_vector],\n",
        "\n",
        "                [target_vector]\n",
        "\n",
        "            )[0][0]\n",
        "\n",
        "            best_similarity = max(\n",
        "\n",
        "                best_similarity,\n",
        "\n",
        "                similarity\n",
        "\n",
        "            )\n",
        "\n",
        "        # thresholded semantic overlap\n",
        "\n",
        "        if best_similarity > 0.60:\n",
        "\n",
        "            semantic_matches += 1\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # semantic overlap confidence\n",
        "    # -----------------------------------------\n",
        "\n",
        "    confidence_score = (\n",
        "\n",
        "        semantic_matches\n",
        "        /\n",
        "        len(source_set)\n",
        "\n",
        "    )\n",
        "\n",
        "    return float(\n",
        "\n",
        "        np.clip(\n",
        "            confidence_score,\n",
        "            0.0,\n",
        "            1.0\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "\n",
        "    # =========================================================\n",
        "# 7.2 USER-ITEM PREFERENCE STABILITY\n",
        "# =========================================================\n",
        "\n",
        "def preference_entropy_confidence(\n",
        "\n",
        "    source_text\n",
        "\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    Preference stability confidence\n",
        "\n",
        "    Lower entropy:\n",
        "        stable preferences\n",
        "\n",
        "    Higher entropy:\n",
        "        diverse preferences\n",
        "    \"\"\"\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # tokenize\n",
        "    # -----------------------------------------\n",
        "\n",
        "    words = str(\n",
        "        source_text\n",
        "    ).lower().split()\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # empty protection\n",
        "    # -----------------------------------------\n",
        "\n",
        "    if len(words) == 0:\n",
        "\n",
        "        return 0.0\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # word frequency\n",
        "    # -----------------------------------------\n",
        "\n",
        "    unique_words, counts = np.unique(\n",
        "\n",
        "        words,\n",
        "\n",
        "        return_counts=True\n",
        "\n",
        "    )\n",
        "\n",
        "    probabilities = (\n",
        "\n",
        "        counts\n",
        "        /\n",
        "        counts.sum()\n",
        "\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # entropy\n",
        "    # -----------------------------------------\n",
        "\n",
        "    entropy_value = entropy(\n",
        "        probabilities\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # normalization\n",
        "    # -----------------------------------------\n",
        "\n",
        "    max_entropy = np.log(\n",
        "        len(unique_words)\n",
        "    )\n",
        "\n",
        "    if max_entropy == 0:\n",
        "\n",
        "        return 1.0\n",
        "\n",
        "    normalized_entropy = (\n",
        "\n",
        "        entropy_value\n",
        "        /\n",
        "        max_entropy\n",
        "\n",
        "    )\n",
        "\n",
        "    confidence_score = (\n",
        "\n",
        "        1\n",
        "        -\n",
        "        normalized_entropy\n",
        "\n",
        "    )\n",
        "\n",
        "    return float(\n",
        "\n",
        "        np.clip(\n",
        "            confidence_score,\n",
        "            0.0,\n",
        "            1.0\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "    # =========================================================\n",
        "# 7.3 USER-LEVEL EMBEDDING ALIGNMENT\n",
        "# =========================================================\n",
        "\n",
        "def embedding_similarity_confidence(\n",
        "\n",
        "    source_embedding,\n",
        "    target_embedding\n",
        "\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    User-level embedding alignment\n",
        "\n",
        "    Uses softened alignment score.\n",
        "    \"\"\"\n",
        "\n",
        "    similarity = cosine_similarity(\n",
        "\n",
        "        [source_embedding],\n",
        "\n",
        "        [target_embedding]\n",
        "\n",
        "    )[0][0]\n",
        "\n",
        "    # soften similarity range\n",
        "\n",
        "    confidence_score = (\n",
        "\n",
        "        similarity + 1\n",
        "    ) / 2\n",
        "\n",
        "    return float(\n",
        "\n",
        "        np.clip(\n",
        "            confidence_score,\n",
        "            0.0,\n",
        "            1.0\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "    # =========================================================\n",
        "# STEP 7.4 — USER-ITEM GENRE DOMAIN GAP\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "User-Item Genre Semantic Distance\n",
        "\n",
        "Formula:\n",
        "\n",
        "c_u^(4)\n",
        "=\n",
        "|| e_u^S - e_u^T ||\n",
        "\n",
        "where:\n",
        "\n",
        "e_u^S\n",
        "=\n",
        "source-domain genre embedding\n",
        "\n",
        "e_u^T\n",
        "=\n",
        "target-domain genre embedding\n",
        "\n",
        "Interpretation:\n",
        "\n",
        "Smaller distance\n",
        "→ smaller domain gap\n",
        "→ higher confidence\n",
        "\n",
        "Larger distance\n",
        "→ larger semantic mismatch\n",
        "→ lower confidence\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# GENRE PREPROCESSING FUNCTION\n",
        "# =========================================================\n",
        "\n",
        "def preprocess_genres(genres_str):\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # null protection\n",
        "    # -----------------------------------------\n",
        "\n",
        "    if pd.isna(genres_str):\n",
        "\n",
        "        return set()\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # string conversion and lowercasing\n",
        "    # -----------------------------------------\n",
        "\n",
        "    genres_str = str(genres_str).lower()\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # split by comma or pipe, then clean\n",
        "    # -----------------------------------------\n",
        "\n",
        "    genres = re.split(r'[,|]', genres_str)\n",
        "\n",
        "    cleaned_genres = set(\n",
        "\n",
        "        genre.strip()\n",
        "\n",
        "        for genre in genres\n",
        "\n",
        "        if genre.strip()\n",
        "\n",
        "    )\n",
        "\n",
        "    return cleaned_genres\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# GENRE EMBEDDING FUNCTION\n",
        "# =========================================================\n",
        "\n",
        "def genre_embedding(genres):\n",
        "\n",
        "    \"\"\"\n",
        "    Convert genre text\n",
        "    into semantic embedding\n",
        "    \"\"\"\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # preprocess genres\n",
        "    # -----------------------------------------\n",
        "\n",
        "    genre_set = preprocess_genres(\n",
        "        genres\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # empty protection\n",
        "    # -----------------------------------------\n",
        "\n",
        "    if len(genre_set) == 0:\n",
        "\n",
        "        return np.zeros(\n",
        "            EMBEDDING_DIM,\n",
        "            dtype=np.float32\n",
        "        )\n",
        "\n",
        "    vectors = []\n",
        "\n",
        "    # -----------------------------------------n\n",
        "    # build genre vectors\n",
        "    # -----------------------------------------\n",
        "\n",
        "    for genre in genre_set:\n",
        "\n",
        "        words = genre.split()\n",
        "\n",
        "        word_vectors = []\n",
        "\n",
        "        for word in words:\n",
        "\n",
        "            if word in embeddings_index:\n",
        "\n",
        "                word_vectors.append(\n",
        "                    embeddings_index[word]\n",
        "                )\n",
        "\n",
        "        # -------------------------------------\n",
        "        # genre-level embedding\n",
        "        # -------------------------------------\n",
        "\n",
        "        if len(word_vectors) > 0:\n",
        "\n",
        "            genre_vector = np.mean(\n",
        "\n",
        "                word_vectors,\n",
        "\n",
        "                axis=0\n",
        "\n",
        "            )\n",
        "\n",
        "            vectors.append(\n",
        "                genre_vector\n",
        "            )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # no valid vectors\n",
        "    # -----------------------------------------\n",
        "\n",
        "    if len(vectors) == 0:\n",
        "\n",
        "        return np.zeros(\n",
        "            EMBEDDING_DIM,\n",
        "            dtype=np.float32\n",
        "        )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # final genre embedding\n",
        "    # -----------------------------------------\n",
        "\n",
        "    return np.mean(\n",
        "        vectors,\n",
        "        axis=0\n",
        "    ).astype(np.float32)\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# USER-ITEM GENRE DISTANCE CONFIDENCE\n",
        "# =========================================================\n",
        "\n",
        "def genre_distance_confidence(\n",
        "\n",
        "    source_genres,\n",
        "    target_genres\n",
        "\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    User-item level\n",
        "    cross-domain genre distance\n",
        "    \"\"\"\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # source embedding\n",
        "    # -----------------------------------------\n",
        "\n",
        "    source_embedding = genre_embedding(\n",
        "        source_genres\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # target embedding\n",
        "    # -----------------------------------------\n",
        "\n",
        "    target_embedding = genre_embedding(\n",
        "        target_genres\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # zero-vector protection\n",
        "    # -----------------------------------------\n",
        "\n",
        "    if np.all(source_embedding == 0) or np.all(target_embedding == 0):\n",
        "\n",
        "        return 0.0\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # Euclidean distance\n",
        "    # -----------------------------------------\n",
        "\n",
        "    distance = np.linalg.norm(\n",
        "\n",
        "        source_embedding\n",
        "        -\n",
        "        target_embedding\n",
        "\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # convert distance to confidence\n",
        "    # -----------------------------------------\n",
        "\n",
        "    confidence_score = 1 / (\n",
        "        1 + distance\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # clamp confidence\n",
        "    # -----------------------------------------\n",
        "\n",
        "    confidence_score = np.clip(\n",
        "\n",
        "        confidence_score,\n",
        "\n",
        "        0.0,\n",
        "\n",
        "        1.0\n",
        "\n",
        "    )\n",
        "\n",
        "    return float(confidence_score)\n",
        "\n",
        "\n",
        "    # =========================================================\n",
        "# 7.5 ITEM-LEVEL SIMILARITY CONFIDENCE\n",
        "# =========================================================\n",
        "\n",
        "def item_similarity_confidence(\n",
        "\n",
        "    source_item_embedding,\n",
        "    target_item_embedding\n",
        "\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    Item-level semantic distance confidence\n",
        "    \"\"\"\n",
        "\n",
        "    distance = np.linalg.norm(\n",
        "\n",
        "        source_item_embedding\n",
        "        -\n",
        "        target_item_embedding\n",
        "\n",
        "    )\n",
        "\n",
        "    confidence_score = 1 / (\n",
        "\n",
        "        1 + distance\n",
        "\n",
        "    )\n",
        "\n",
        "    return float(\n",
        "\n",
        "        np.clip(\n",
        "            confidence_score,\n",
        "            0.0,\n",
        "            1.0\n",
        "        )\n",
        "\n",
        "    )"
      ]
    },
