      "source": [
        "# =========================================================\n",
        "# STEP 9 — TARGET DOMAIN PREDICTION\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Target Domain Prediction\n",
        "\n",
        "Prediction Equation:\n",
        "\n",
        "r_hat(u,i)\n",
        "\n",
        "=\n",
        "ê_u^T · e_i^T\n",
        "\n",
        "where:\n",
        "\n",
        "ê_u\n",
        "=\n",
        "final transferred user embedding\n",
        "\n",
        "e_i^T\n",
        "=\n",
        "target-domain item embedding\n",
        "\n",
        "Interpretation:\n",
        "\n",
        "Higher score\n",
        "=\n",
        "higher recommendation relevance\n",
        "\n",
        "Goal:\n",
        "\n",
        "Compute ranking scores between:\n",
        "\n",
        "book-side transferred embeddings\n",
        "\n",
        "and\n",
        "\n",
        "movie embeddings\n",
        "\"\"\"\n",
        "\n",
        "print(\"\\nGenerating target-domain predictions...\\n\")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# NORMALIZE EMBEDDINGS\n",
        "# =========================================================\n",
        "\n",
        "final_transferred_embeddings = normalize(\n",
        "    final_transferred_embeddings\n",
        ")\n",
        "\n",
        "movie_embeddings = normalize(\n",
        "    movie_embeddings\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# DOT-PRODUCT PREDICTION\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Prediction Matrix Shape:\n",
        "\n",
        "[num_books × num_movies]\n",
        "\"\"\"\n",
        "\n",
        "target_prediction_matrix = np.matmul(\n",
        "\n",
        "    final_transferred_embeddings,\n",
        "\n",
        "    movie_embeddings.T\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# DISPLAY INFORMATION\n",
        "# =========================================================\n",
        "\n",
        "print(\n",
        "    \"Target-domain prediction matrix generated!\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"\\nPrediction Matrix Shape : \"\n",
        "    f\"{target_prediction_matrix.shape}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Maximum Prediction Score : \"\n",
        "    f\"{target_prediction_matrix.max():.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Minimum Prediction Score : \"\n",
        "    f\"{target_prediction_matrix.min():.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Average Prediction Score : \"\n",
        "    f\"{target_prediction_matrix.mean():.4f}\"\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 9.1 — PREDICTION FUNCTION\n",
        "# =========================================================\n",
        "\n",
        "def predict_target_scores(\n",
        "\n",
        "    book_title,\n",
        "\n",
        "    top_n=10\n",
        "\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    Predict top target-domain movies\n",
        "    for a given source-domain book.\n",
        "    \"\"\"\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # locate book\n",
        "    # -----------------------------------------\n",
        "\n",
        "    matched = books[\n",
        "\n",
        "        books['book_title']\n",
        "        .str.lower()\n",
        "        ==\n",
        "        book_title.lower()\n",
        "\n",
        "    ]\n",
        "\n",
        "    if len(matched) == 0:\n",
        "\n",
        "        print(\"\\nBook not found!\")\n",
        "\n",
        "        return\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # book index\n",
        "    # -----------------------------------------\n",
        "\n",
        "    book_idx = matched.index[0]\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # prediction scores\n",
        "    # -----------------------------------------\n",
        "\n",
        "    scores = target_prediction_matrix[\n",
        "        book_idx\n",
        "    ]\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # top-ranked movies\n",
        "    # -----------------------------------------\n",
        "\n",
        "    top_movie_indices = np.argsort(\n",
        "        scores\n",
        "    )[::-1][:top_n]\n",
        "\n",
        "    # =====================================================\n",
        "    # DISPLAY RESULTS\n",
        "    # =====================================================\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 80)\n",
        "\n",
        "    print(\n",
        "        f\"TARGET-DOMAIN PREDICTIONS FOR : \"\n",
        "        f\"{book_title}\"\n",
