        "# =========================================================\n",
        "# STEP 2 — LOAD DATASETS\n",
        "# =========================================================\n",
        "\n",
        "# Download datasets\n",
        "drive.mount('/content/drive')\n",
        "\n",

        DATA_DIR = "data"
         
        "# Amazon Book Dataset\n",
        "#books = os.path.join(DATA_DIR, "bestsellers with categories.csv\")\n",
        "books = os.path.join(DATA_DIR, book_data.csv')\n",
        "\n",
        "# Netflix Movie Dataset\n",
        "#movies =os.path.join(DATA_DIR, "imdb-movies-dataset.csv\")\n",
        "movies = os.path.join(DATA_DIR, imdb-movies-dataset.csv')\n",
        "\n",
        "# =========================================================\n",
        "# STEP 3 — SELECT IMPORTANT COLUMNS\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Expected Columns\n",
        "\n",
        "Books Dataset:\n",
        "---------------\n",
        "title\n",
        "description\n",
        "category\n",
        "\n",
        "Movies Dataset:\n",
        "----------------\n",
        "title\n",
        "description\n",
        "genre\n",
        "\"\"\"\n",
        "\n",
        "books = books[['book_authors', 'book_desc', 'book_rating','book_rating_count','book_review_count','book_title', 'genres']]\n",
        "movies = movies[['Title', 'Year', 'Genre', 'Rating', 'Review Count', 'Votes','Description', 'Review']]\n",
        "\n",
        "books = books.fillna(\"\")\n",
        "movies = movies.fillna(\"\")\n",
        "\n",
        "# =========================================================\n",
        "# STEP 4 — TEXT CLEANING\n",
        "# =========================================================\n",
        "\n",
        "def clean_text(text):\n",
        "\n",
        "    text = text.lower()\n",
        "\n",
        "    text = re.sub(r'[^a-zA-Z ]', ' ', text)\n",
        "\n",
        "    text = re.sub(r'\\s+', ' ', text)\n",
        "\n",
        "    return text.strip()\n",
        "\n",
        "\n",
        "books['combined_text'] = (\n",
        "    books['book_authors'].astype(str) + \" \" +\n",
        "    books['book_desc'].astype(str) + \" \" +\n",
        "    books['book_rating'].astype(str) + \" \" +\n",
        "    books['book_rating_count'].astype(str) + \" \" +\n",
        "    books['book_review_count'].astype(str) + \" \" +\n",
        "    books['book_title'].astype(str) + \" \" +\n",
        "    books['genres'].astype(str)\n",
        ").apply(clean_text)\n",
        "\n",
        "\n",
        "movies['combined_text'] = (\n",
        "    movies['Title'].astype(str) + \" \" +\n",
        "    movies['Year'].astype(str) + \" \" +\n",
        "    movies['Genre'].astype(str) + \" \" +\n",
        "    movies['Rating'].astype(str) + \" \" +\n",
        "    movies['Review Count'].astype(str) + \" \" +\n",
        "    movies['Votes'].astype(str) + \" \" +\n",
        "    movies['Description'].astype(str) + \" \" +\n",
        "    movies['Review'].astype(str)\n",
        ").apply(clean_text)\n"
      ]
