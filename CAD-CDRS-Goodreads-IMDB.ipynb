      "source": [
        "# =========================================================\n",
        "# STEP 7.7 — LEARNABLE MULTI-SIGNAL CONFIDENCE NETWORK\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Learnable Confidence Network\n",
        "\n",
        "Input:\n",
        "\n",
        "[c1, c2, c3, c4, c5]\n",
        "\n",
        "where:\n",
        "\n",
        "c1 → interaction overlap confidence\n",
        "c2 → preference stability confidence\n",
        "c3 → embedding alignment confidence\n",
        "c4 → genre domain-gap confidence\n",
        "c5 → item similarity confidence\n",
        "\n",
        "Output:\n",
        "\n",
        "final confidence score\n",
        "\n",
        "Goal:\n",
        "\n",
        "Learn adaptive weighting of\n",
        "multi-signal confidence features.\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# NORMALIZE CONFIDENCE FEATURES\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nPreparing confidence features...\\n\")\n",
        "\n",
        "scaler = MinMaxScaler()\n",
        "\n",
        "X_conf = scaler.fit_transform(\n",
        "    confidence_features\n",
        ").astype(np.float32)\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# IMPROVED PSEUDO TARGETS\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Weighted pseudo supervision\n",
        "\n",
        "More stable than simple averaging.\n",
        "\"\"\"\n",
        "\n",
        "WEIGHT_C1 = 0.20\n",
        "WEIGHT_C2 = 0.15\n",
        "WEIGHT_C3 = 0.25\n",
        "WEIGHT_C4 = 0.15\n",
        "WEIGHT_C5 = 0.25\n",
        "\n",
        "\n",
        "pseudo_targets = (\n",
        "\n",
        "    WEIGHT_C1 * confidence_features[:, 0]\n",
        "\n",
        "    +\n",
        "\n",
        "    WEIGHT_C2 * confidence_features[:, 1]\n",
        "\n",
        "    +\n",
        "\n",
        "    WEIGHT_C3 * confidence_features[:, 2]\n",
        "\n",
        "    +\n",
        "\n",
        "    WEIGHT_C4 * confidence_features[:, 3]\n",
        "\n",
        "    +\n",
        "\n",
        "    WEIGHT_C5 * confidence_features[:, 4]\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# CLIP TARGETS\n",
        "# =========================================================\n",
        "\n",
        "pseudo_targets = np.clip(\n",
        "\n",
        "    pseudo_targets,\n",
        "\n",
        "    0.0,\n",
        "\n",
        "    1.0\n",
        "\n",
        ").astype(np.float32)\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# CONFIDENCE NETWORK\n",
        "# =========================================================\n",
        "\n",
        "confidence_model = MLPRegressor(\n",
        "\n",
        "    hidden_layer_sizes=(64, 32, 16),\n",
        "\n",
        "    activation='relu',\n",
        "\n",
        "    solver='adam',\n",
        "\n",
        "    alpha=1e-4,\n",
        "\n",
        "    learning_rate='adaptive',\n",
        "\n",
        "    max_iter=300,\n",
        "\n",
        "    early_stopping=True,\n",
        "\n",
        "    validation_fraction=0.1,\n",
        "\n",
        "    n_iter_no_change=10,\n",
        "\n",
        "    random_state=42\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# TRAIN CONFIDENCE NETWORK\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nTraining confidence network...\\n\")\n",
        "\n",
        "confidence_model.fit(\n",
        "\n",
        "    X_conf,\n",
        "\n",
        "    pseudo_targets\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# GENERATE FINAL CONFIDENCE SCORES\n",
        "# =========================================================\n",
        "\n",
        "final_confidence_scores = confidence_model.predict(\n",
        "    X_conf\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# NORMALIZE FINAL SCORES\n",
        "# =========================================================\n",
        "\n",
        "final_confidence_scores = np.clip(\n",
        "\n",
        "    final_confidence_scores,\n",
        "\n",
        "    0.0,\n",
        "\n",
        "    1.0\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# DISPLAY RESULTS\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nConfidence learning completed!\")\n",
        "\n",
        "print(\n",
        "    f\"Confidence Score Shape : \"\n",
        "    f\"{final_confidence_scores.shape}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Minimum Confidence     : \"\n",
        "    f\"{final_confidence_scores.min():.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Maximum Confidence     : \"\n",
        "    f\"{final_confidence_scores.max():.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Average Confidence     : \"\n",
        "    f\"{final_confidence_scores.mean():.4f}\"\n",
        ")"
      ]
    },
