      "source": [
        "# =========================================================\n",
        "# STEP 10 — BAYESIAN PERSONALIZED RANKING (BPR) LOSS\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Ranking Loss (Primary Objective)\n",
        "\n",
        "Equation:\n",
        "\n",
        "L_BPR\n",
        "\n",
        "=\n",
        "-log σ(\n",
        "    r_hat(u,i)\n",
        "    -\n",
        "    r_hat(u,j)\n",
        ")\n",
        "\n",
        "where:\n",
        "\n",
        "r_hat(u,i)\n",
        "=\n",
        "positive item prediction\n",
        "\n",
        "r_hat(u,j)\n",
        "=\n",
        "negative item prediction\n",
        "\n",
        "σ\n",
        "=\n",
        "sigmoid function\n",
        "\n",
        "Goal:\n",
        "\n",
        "Optimize ranking quality by:\n",
        "\n",
        "✔ increasing scores of relevant items\n",
        "✔ decreasing scores of irrelevant items\n",
        "\n",
        "Improves:\n",
        "\n",
        "✔ NDCG\n",
        "✔ Hit Ratio\n",
        "✔ Recall\n",
        "✔ Ranking robustness\n",
        "\"\"\"\n",
        "\n",
        "import torch.nn.functional as F\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 10.1 — CONVERT TO TORCH TENSORS\n",
        "# =========================================================\n",
        "\n",
        "# Keep book_tensor and movie_tensor as they are, but they are read-only here\n",
        "# The transferred_tensor will be computed dynamically within the loop\n",
        "\n",
        "# book_tensor and movie_tensor were created in STEP 8.1.2 and STEP 8.5 respectively\n",
        "# confidence_tensor was created in STEP 8.1.3\n",
        "# alpha_schedule was created in STEP 8.1.5 and STEP 8.2\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 10.2 — BPR LOSS FUNCTION\n",
        "# =========================================================\n",
        "\n",
        "def bpr_loss(\n",
        "\tuser_embedding,\n",
        "\tpositive_item_embedding,\n",
        "\tnegative_item_embedding\n",
        "):\n",
        "\t\"\"\"\n",
        "\tBayesian Personalized Ranking Loss\n",
        "\t\"\"\"\n",
        "\t# -----------------------------------------\n",
        "\t# positive prediction\n",
        "\t# r_hat(u,i)\n",
        "\t# -----------------------------------------\n",
        "\tpositive_score = torch.sum(\n",
        "\t\tuser_embedding\n",
        "\t\t*\n",
        "\t\tpositive_item_embedding,\n",
        "\t\tdim=1\n",
        "\t)\n",
        "\n",
        "\t# -----------------------------------------\n",
        "\t# negative prediction\n",
        "\t# r_hat(u,j)\n",
        "\t# -----------------------------------------\n",
        "\tnegative_score = torch.sum(\n",
        "\t\tuser_embedding\n",
        "\t\t*\n",
        "\t\tnegative_item_embedding,\n",
        "\t\tdim=1\n",
        "\t)\n",
        "\n",
        "\t# -----------------------------------------\n",
        "\t# BPR loss\n",
        "\t# -----------------------------------------\n",
        "\tloss = -torch.mean(\n",
        "\t\tF.logsigmoid(\n",
        "\t\t\tpositive_score\n",
        "\t\t\t-\n",
        "\t\t\tnegative_score\n",
        "\t\t)\n",
        "\t)\n",
        "\n",
        "\treturn loss\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 10.3 — BPR TRAINING PREPARATION\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nPreparing BPR ranking optimization...\\n\")\n",
        "\n",
        "# The optimizer should optimize the parameters of denoising_model\n",
        "optimizer_bpr = optim.Adam(\n",
        "    denoising_model.parameters(),\n",
        "    lr=0.0005\n",
        ")\n",
        "\n",
        "BPR_EPOCHS = 5\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 10.4 — BPR TRAINING LOOP\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nTraining ranking objective using BPR...\\n\")\n",
        "\n",
        "# Pre-calculate matching matrix for target_context selection\n",
        "# Use the `similarity_matrix` from STEP 7.6 as initial matching for context\n",
        "# after normalization in that step.\n",
        "# Or recompute from `book_embeddings` and `movie_embeddings` which are normalized already in STEP 8.6.\n",
        "# Let's use cosine_similarity on the normalized `book_embeddings` and `movie_embeddings` which are used throughout.\n",
        "initial_context_matching_matrix = cosine_similarity(\n",
        "    book_embeddings,\n",
        "    movie_embeddings\n",
        ")\n",
        "\n",
        "for epoch in range(BPR_EPOCHS):\n",
        "\ttotal_bpr_loss = 0\n",
        "\n",
        "\t# Ensure denoising_model is in training mode\n",
        "\tdenoising_model.train()\n",
        "\n",
        "\t# Iterate over each book to generate its transferred embedding and compute BPR loss\n",
        "\tfor i in tqdm(range(len(book_tensor)), desc=f\"BPR Epoch {epoch+1}\"):\n",
        "\n",
        "\t\t# --- GENERATE USER EMBEDDING (TRANSFERRED EMBEDDING) ON THE FLY ---\n",
        "\t\t# This re-runs parts of STEP 8.6 and STEP 8.7 to ensure gradient flow to denoising_model\n",
        "\n",
        "\t\t# 1. Get source embedding x0 and confidence\n",
        "\t\tx0 = book_tensor[i].unsqueeze(0)\n",
        "\t\tconfidence = confidence_tensor[i].unsqueeze(0)\n",
        "\n",
        "\t\t# 2. Determine target_context (movie for the book)\n",
        "\t\t# Use the pre-calculated initial_context_matching_matrix to find the movie context\n",
        "\t\tmovie_idx_for_context = np.argmax(initial_context_matching_matrix[i])\n",
        "\t\ttarget_context = movie_tensor[movie_idx_for_context].unsqueeze(0)\n",
        "\n",
        "\t\t# 3. Perform iterative reverse diffusion (as in STEP 8.6)\n",
        "\t\t# Initialize z_t for book i\n",
        "\t\tz_t, _ = confidence_gated_forward_diffusion(\n",
        "\t\t\tx0,\n",
        "\t\t\tconfidence,\n",
        "\t\t\tT - 1\n",
        "\t\t)\n",
        "\n",
        "\t\t# Loop T times for reverse diffusion\n",
        "\t\tfor t_step in reversed(range(T)):\n",
        "\t\t\ttimestep_tensor = torch.tensor([t_step / T], dtype=torch.float32).to(device)\n",
        "\t\t\treconstructed_embedding = denoising_model(\n",
        "\t\t\t\tz_t,\n",
        "\t\t\t\tconfidence,\n",
        "\t\t\t\ttarget_context,\n",
        "\t\t\t\ttimestep_tensor\n",
        "\t\t\t)\n",
        "\t\t\talpha_t_val = alpha_schedule[t_step]\n",
        "\t\t\tz_t = (\n",
        "\t\t\t\ttorch.sqrt(alpha_t_val)\n",
        "\t\t\t\t*\n",
        "\t\t\t\treconstructed_embedding\n",
        "\t\t\t\t+\n",
        "\t\t\t\ttorch.sqrt(1 - alpha_t_val)\n",
        "\t\t\t\t*\n",
        "\t\t\t\ttarget_context\n",
        "\t\t\t)\n",
        "\t\tfinal_embedding_after_denoising = (0.6 * x0 + 0.4 * z_t)\n",
        "\t\tfinal_embedding_after_denoising = torch.clamp(final_embedding_after_denoising, -3, 3)\n",
        "\n",
        "\t\t# 4. Perform gated fusion (as in STEP 8.7)\n",
        "\t\ttransferred_embedding_from_denoising = final_embedding_after_denoising\n",
        "\t\tfinal_user_embedding = (\n",
        "\t\t\t(1 - confidence)\n",
        "\t\t\t*\n",
        "\t\t\ttarget_context\n",
        "\t\t\t+\n",
        "\t\t\tconfidence\n",
        "\t\t\t*\n",
        "\t\t\ttransferred_embedding_from_denoising\n",
        "\t\t)\n",
        "\t\t# Optional residual stabilization from STEP 8.7\n",
        "\t\tfinal_user_embedding = (\n",
        "\t\t\t0.8 * final_user_embedding\n",
        "\t\t\t+\n",
        "\t\t\t0.2 * target_context\n",
        "\t\t)\n",
        "\t\tuser_embedding = F.normalize(final_user_embedding, p=2, dim=1)\n",
        "\t\t# --- END OF USER EMBEDDING GENERATION ---\n",
        "\n",
        "\t\t# -----------------------------------------\n",
        "\t\t# similarity scores for sampling positive/negative movies\n",
        "\t\t# Use the dynamically generated user_embedding\n",
        "\t\t# Use movie_tensor for item embeddings, which is fixed by this optimizer\n",
        "\t\tscores = torch.matmul(\n",
        "\t\t\tuser_embedding,\n",
        "\t\t\tmovie_tensor.T\n",
        "\t\t).squeeze(0)\n",
        "\n",
        "\t\t# -----------------------------------------\n",
        "\t\t# positive item (highest score for current user_embedding)\n",
        "\t\t# Note: This is an implicit positive from the predicted scores, not a ground truth.\n",
        "\t\t# For actual recommendation, you'd use observed user-item interactions.\n",
        "\t\tpositive_idx = torch.argmax(\n",
        "\t\t\tscores\n",
        "\t\t).item()\n",
        "\n",
        "\t\t# -----------------------------------------\n",
        "\t\t# negative sampling (randomly choose one that is not the positive)\n",
        "\t\tnegative_idx = np.random.randint(\n",
        "\t\t\t0,\n",
        "\t\t\tlen(movie_embeddings)\n",
        "\t\t)\n",
        "\t\twhile negative_idx == positive_idx:\n",
        "\t\t\tnegative_idx = np.random.randint(\n",
        "\t\t\t\t0,\n",
        "\t\t\t\tlen(movie_embeddings)\n",
        "\t\t\t)\n",
        "\n",
        "\t\t# -----------------------------------------\n",
        "\t\t# positive embedding\n",
        "\t\t# These are still from the fixed movie_tensor, not part of denoising_model's trainable params\n",
        "\t\tpositive_embedding = movie_tensor[\n",
        "\t\t\tpositive_idx\n",
        "\t\t].unsqueeze(0)\n",
        "\n",
        "\t\t# -----------------------------------------\n",
        "\t\t# negative embedding\n",
        "\t\tnegative_embedding = movie_tensor[\n",
        "\t\t\tnegative_idx\n",
        "\t\t].unsqueeze(0)\n",
        "\n",
        "\t\t# -----------------------------------------\n",
        "\t\t# compute BPR loss\n",
        "\t\tloss = bpr_loss(\n",
        "\t\t\tuser_embedding,\n",
        "\t\t\tpositive_embedding,\n",
        "\t\t\tnegative_embedding\n",
        "\t\t)\n",
        "\n",
        "\t\t# -----------------------------------------\n",
        "\t\t# optimization\n",
        "\t\t# Only denoising_model's parameters are updated by optimizer_bpr\n",
        "\t\toptimizer_bpr.zero_grad()\n",
        "\t\tloss.backward()\n",
        "\t\toptimizer_bpr.step()\n",
        "\n",
        "\t\ttotal_bpr_loss += loss.item()\n",
        "\n",
        "\t# =====================================================\n",
        "\t# DISPLAY EPOCH LOSS\n",
        "\t# =====================================================\n",
        "\n",
        "\tprint(\n",
        "\t\tf\"Epoch {epoch+1}/{BPR_EPOCHS}\"\n",
        "\t\t\tf\" | BPR Loss : \"\n",
        "\t\t\tf\"{total_bpr_loss:.4f}\"\n",
        "\t)\n",
        "\n",
        "\n",
        "print(\"\\nBPR ranking optimization completed!\")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 10.5 — UPDATE PREDICTION MATRIX\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nUpdating ranking predictions...\\n\")\n",
        "\n",
        "# After BPR training, regenerate final_transferred_embeddings to reflect model updates\n",
        "# This loop is outside the BPR_EPOCHS loop, so it needs to recreate all transferred embeddings.\n",
        "# Ensure denoising_model is in evaluation mode for inference\n",
        "denoising_model.eval()\n",
        "\n",
        "new_final_transferred_embeddings_list = []\n",
        "with torch.no_grad(): # No need to track gradients for inference\n",
        "    for i in tqdm(range(len(book_tensor)), desc=\"Regenerating transferred embeddings\"):\n",
        "        x0 = book_tensor[i].unsqueeze(0)\n",
        "        confidence = confidence_tensor[i].unsqueeze(0)\n",
        "        movie_idx_for_context = np.argmax(initial_context_matching_matrix[i])\n",
        "        target_context = movie_tensor[movie_idx_for_context].unsqueeze(0)\n",
        "\n",
        "        z_t, _ = confidence_gated_forward_diffusion(\n",
        "            x0,\n",
        "            confidence,\n",
        "            T - 1\n",
        "        )\n",
        "\n",
        "        for t_step in reversed(range(T)):\n",
        "            timestep_tensor = torch.tensor([t_step / T], dtype=torch.float32).to(device)\n",
        "            reconstructed_embedding = denoising_model(\n",
        "                z_t,\n",
        "                confidence,\n",
        "                target_context,\n",
        "                timestep_tensor\n",
        "            )\n",
        "            alpha_t_val = alpha_schedule[t_step]\n",
        "            z_t = (\n",
        "                torch.sqrt(alpha_t_val)\n",
        "                *\n",
        "                reconstructed_embedding\n",
        "                +\n",
        "                torch.sqrt(1 - alpha_t_val)\n",
        "                *\n",
        "                target_context\n",
        "            )\n",
        "        final_embedding_after_denoising = (0.6 * x0 + 0.4 * z_t)\n",
        "        final_embedding_after_denoising = torch.clamp(final_embedding_after_denoising, -3, 3)\n",
        "\n",
        "        transferred_embedding_from_denoising = final_embedding_after_denoising\n",
        "        final_user_embedding = (\n",
        "            (1 - confidence)\n",
        "            *\n",
        "            target_context\n",
        "            +\n",
        "            confidence\n",
        "            *\n",
        "            transferred_embedding_from_denoising\n",
        "        )\n",
        "        final_user_embedding = (\n",
        "            0.8 * final_user_embedding\n",
        "            +\n",
        "            0.2 * target_context\n",
        "        )\n",
        "        new_final_transferred_embeddings_list.append(\n",
        "            F.normalize(final_user_embedding, p=2, dim=1).cpu().numpy()[0]\n",
        "        )\n",
        "\n",
        "final_transferred_embeddings = np.array(new_final_transferred_embeddings_list)\n",
        "\n",
        "# Ensure final_transferred_embeddings is normalized again if F.normalize was not used in the loop\n",
        "final_transferred_embeddings = normalize(final_transferred_embeddings)\n",
        "\n",
        "# Convert movie_embeddings to a tensor for the dot product if needed, but it should be normalized already.\n",
        "# movie_embeddings = normalize(movie_embeddings) # Already normalized in STEP 8.6\n",
        "\n",
        "target_prediction_matrix = np.matmul(\n",
        "\tfinal_transferred_embeddings,\n",
        "\tmovie_embeddings.T\n",
        ")\n",
        "\n",
        "print(\n",
        "\t\"Prediction matrix updated after BPR optimization!\"\n",
        ")\n"
      ]
