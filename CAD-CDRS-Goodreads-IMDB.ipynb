      "source": [
        "# =========================================================\n",
        "# STEP 14 — FINAL TOP-K RECOMMENDATION GENERATION\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Final Recommendation Phase\n",
        "\n",
        "Prediction:\n",
        "\n",
        "r_hat(u,i)\n",
        "\n",
        "=\n",
        "e_tilde_u^T e_i^T\n",
        "\n",
        "Memory-Efficient Version\n",
        "\n",
        "No full score matrix is created.\n",
        "\n",
        "Scores are computed only for\n",
        "the requested book.\n",
        "\"\"\"\n",
        "\n",
        "print(\"\\nGenerating Final Top-K Recommendations...\\n\")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 14.1 — MEMORY-EFFICIENT PREDICTION\n",
        "# =========================================================\n",
        "\n",
        "print(\n",
        "    \"\\nUsing memory-efficient prediction...\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Books  : {len(final_transferred_embeddings)}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Movies : {len(movie_embeddings)}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\nNo full score matrix created.\"\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# PRE-EXTRACT MOVIE INFORMATION\n",
        "# =========================================================\n",
        "\n",
        "movie_titles = movies[\"Title\"].values\n",
        "\n",
        "movie_genres = movies[\"Genre\"].values\n",
        "\n",
        "movie_ratings = movies[\"Rating\"].values\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# SCORE COMPUTATION FUNCTION\n",
        "# =========================================================\n",
        "\n",
        "def compute_scores(book_idx):\n",
        "\n",
        "    \"\"\"\n",
        "    Compute ranking scores\n",
        "\n",
        "    r_hat(u,i)\n",
        "\n",
        "    =\n",
        "    e_tilde_u^T e_i^T\n",
        "    \"\"\"\n",
        "\n",
        "    return np.dot(\n",
        "\n",
        "        movie_embeddings,\n",
        "\n",
        "        final_transferred_embeddings[\n",
        "            book_idx\n",
        "        ]\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# TOP-K RETRIEVAL\n",
        "# =========================================================\n",
        "\n",
        "def get_top_k_movies(\n",
        "\n",
        "    book_idx,\n",
        "\n",
        "    k=10\n",
        "\n",
        "):\n",
        "\n",
        "    scores = compute_scores(\n",
        "        book_idx\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # Fast Top-K retrieval\n",
        "    # -----------------------------------------\n",
        "\n",
        "    top_indices = np.argpartition(\n",
        "\n",
        "        scores,\n",
        "\n",
        "        -k\n",
        "\n",
        "    )[-k:]\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # Sort Top-K only\n",
        "    # -----------------------------------------\n",
        "\n",
        "    top_indices = top_indices[\n",
        "\n",
        "        np.argsort(\n",
        "\n",
        "            scores[top_indices]\n",
        "\n",
        "        )[::-1]\n",
        "\n",
        "    ]\n",
        "\n",
        "    return top_indices, scores\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 14.2 — RECOMMENDATION FUNCTION\n",
        "# =========================================================\n",
        "\n",
        "def generate_topk_recommendations(\n",
        "\n",
        "    book_title,\n",
        "\n",
        "    K=10,\n",
        "\n",
        "    diversity_threshold=0.95\n",
        "\n",
        "):\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # Find book\n",
        "    # -----------------------------------------\n",
        "\n",
        "    matched = books[\n",
        "\n",
        "        books[\"book_title\"]\n",
        "        .str.lower()\n",
        "        ==\n",
        "        book_title.lower()\n",
        "\n",
        "    ]\n",
        "\n",
        "    if len(matched) == 0:\n",
        "\n",
        "        print(\n",
        "            f\"\\nBook '{book_title}' not found.\"\n",
        "        )\n",
        "\n",
        "        return None\n",
        "\n",
        "    book_idx = matched.index[0]\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # Candidate pool\n",
        "    # -----------------------------------------\n",
        "\n",
        "    candidate_size = min(\n",
        "\n",
        "        max(K * 5, 50),\n",
        "\n",
        "        len(movie_embeddings)\n",
        "\n",
        "    )\n",
        "\n",
        "    candidate_indices, scores = (\n",
        "\n",
        "        get_top_k_movies(\n",
        "\n",
        "            book_idx,\n",
        "\n",
        "            candidate_size\n",
        "\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # Diversity Filtering\n",
        "    # -----------------------------------------\n",
        "\n",
        "    selected_movies = []\n",
        "\n",
        "    for idx in candidate_indices:\n",
        "\n",
        "        if len(selected_movies) == 0:\n",
        "\n",
        "            selected_movies.append(idx)\n",
        "\n",
        "            continue\n",
        "\n",
        "        similarity = cosine_similarity(\n",
        "\n",
        "            [movie_embeddings[idx]],\n",
        "\n",
        "            movie_embeddings[\n",
        "                selected_movies\n",
        "            ]\n",
        "\n",
        "        )[0]\n",
        "\n",
        "        if np.max(similarity) < diversity_threshold:\n",
        "\n",
        "            selected_movies.append(idx)\n",
        "\n",
        "        if len(selected_movies) >= K:\n",
        "\n",
        "            break\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # Build Results\n",
        "    # -----------------------------------------\n",
        "\n",
        "    recommendations = []\n",
        "\n",
        "    for rank, movie_idx in enumerate(\n",
        "\n",
        "        selected_movies,\n",
        "\n",
        "        start=1\n",
        "\n",
        "    ):\n",
        "\n",
        "        recommendations.append({\n",
        "\n",
        "            \"Rank\":\n",
        "            rank,\n",
        "\n",
        "            \"Movie\":\n",
        "            movie_titles[movie_idx],\n",
        "\n",
        "            \"Genre\":\n",
        "            movie_genres[movie_idx],\n",
        "\n",
        "            \"Rating\":\n",
        "            movie_ratings[movie_idx],\n",
        "\n",
        "            \"Score\":\n",
        "            float(scores[movie_idx])\n",
        "\n",
        "        })\n",
        "\n",
        "    return recommendations\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 14.3 — DISPLAY RECOMMENDATIONS\n",
        "# =========================================================\n",
        "\n",
        "def display_recommendations(\n",
        "\n",
        "    book_title,\n",
        "\n",
        "    K=10\n",
        "\n",
        "):\n",
        "\n",
        "    recommendations = (\n",
        "\n",
        "        generate_topk_recommendations(\n",
        "\n",
        "            book_title,\n",
        "\n",
        "            K\n",
        "\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "    if recommendations is None:\n",
        "\n",
        "        return\n",
        "\n",
        "    print(\"\\n\")\n",
        "    print(\"=\" * 90)\n",
        "\n",
        "    print(\n",
        "        f\"TOP-{K} MOVIE RECOMMENDATIONS\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"FOR BOOK : {book_title}\"\n",
        "    )\n",
        "\n",
        "    print(\"=\" * 90)\n",
        "\n",
        "    for item in recommendations:\n",
        "\n",
        "        print(\n",
        "\n",
        "            f\"\\nRank #{item['Rank']}\"\n",
        "\n",
        "        )\n",
        "\n",
        "        print(\n",
        "\n",
        "            f\"Movie  : {item['Movie']}\"\n",
        "\n",
        "        )\n",
        "\n",
        "        print(\n",
        "\n",
        "            f\"Genre  : {item['Genre']}\"\n",
        "\n",
        "        )\n",
        "\n",
        "        print(\n",
        "\n",
        "            f\"Rating : {item['Rating']}\"\n",
        "\n",
        "        )\n",
        "\n",
        "        print(\n",
        "\n",
        "            f\"Score  : {item['Score']:.4f}\"\n",
        "\n",
        "        )\n",
        "\n",
        "        print(\"-\" * 90)\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 14.4 — EXAMPLE\n",
        "# =========================================================\n",
        "\n",
        "display_recommendations(\n",
        "\n",
        "    book_title=\"Harry Potter and the Order of the Phoenix\",\n",
        "\n",
        "    K=10\n",
        "\n",
        ")"
      ]
    },
