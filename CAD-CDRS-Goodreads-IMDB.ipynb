      "source": [
        "# =========================================================\n",
        "# STEP 8.5 — TRAIN REVERSE DIFFUSION NETWORK\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Reverse Diffusion Training\n",
        "\n",
        "Goal:\n",
        "\n",
        "Learn clean target-aligned representations\n",
        "\n",
        "Input:\n",
        "\n",
        "z_(u,i)^t\n",
        "c_(u,i)\n",
        "e_i^T\n",
        "t\n",
        "\n",
        "Output:\n",
        "\n",
        "z_(u,i)^(t-1)\n",
        "\n",
        "Optimized Version\n",
        "\n",
        "✔ No matching matrix\n",
        "✔ No full similarity matrix\n",
        "✔ Batch training\n",
        "✔ Precomputed target context\n",
        "✔ Colab-friendly\n",
        "\"\"\"\n",
        "\n",
        "from torch.utils.data import TensorDataset\n",
        "from torch.utils.data import DataLoader\n",
        "\n",
        "# =========================================================\n",
        "# MOVIE EMBEDDING TENSOR\n",
        "# =========================================================\n",
        "\n",
        "movie_tensor = torch.tensor(\n",
        "\n",
        "    movie_embeddings,\n",
        "\n",
        "    dtype=torch.float32\n",
        "\n",
        ").to(device)\n",
        "\n",
        "# =========================================================\n",
        "# PRECOMPUTE BEST TARGET MOVIE\n",
        "# =========================================================\n",
        "\n",
        "print(\n",
        "    \"\\nPrecomputing target contexts...\\n\"\n",
        ")\n",
        "\n",
        "best_movie_indices = []\n",
        "\n",
        "for i in tqdm(\n",
        "\n",
        "    range(len(book_embeddings)),\n",
        "\n",
        "    desc=\"Matching Books to Movies\"\n",
        "\n",
        "):\n",
        "\n",
        "    scores = np.dot(\n",
        "\n",
        "        movie_embeddings,\n",
        "\n",
        "        book_embeddings[i]\n",
        "\n",
        "    )\n",
        "\n",
        "    best_movie_indices.append(\n",
        "\n",
        "        np.argmax(scores)\n",
        "\n",
        "    )\n",
        "\n",
        "best_movie_indices = np.array(\n",
        "\n",
        "    best_movie_indices,\n",
        "\n",
        "    dtype=np.int32\n",
        "\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Target context matching completed!\"\n",
        ")\n",
        "\n",
        "# =========================================================\n",
        "# DATASET\n",
        "# =========================================================\n",
        "\n",
        "target_index_tensor = torch.tensor(\n",
        "\n",
        "    best_movie_indices,\n",
        "\n",
        "    dtype=torch.long\n",
        "\n",
        ")\n",
        "\n",
        "dataset = TensorDataset(\n",
        "\n",
        "    book_tensor,\n",
        "\n",
        "    confidence_tensor,\n",
        "\n",
        "    target_index_tensor\n",
        "\n",
        ")\n",
        "\n",
        "loader = DataLoader(\n",
        "\n",
        "    dataset,\n",
        "\n",
        "    batch_size=256,\n",
        "\n",
        "    shuffle=True,\n",
        "\n",
        "    pin_memory=False\n",
        "\n",
        ")\n",
        "\n",
        "# =========================================================\n",
        "# OPTIMIZER\n",
        "# =========================================================\n",
        "\n",
        "optimizer = optim.Adam(\n",
        "\n",
        "    denoising_model.parameters(),\n",
        "\n",
        "    lr=0.0005\n",
        "\n",
        ")\n",
        "\n",
        "criterion = nn.MSELoss()\n",
        "\n",
        "EPOCHS = 10\n",
        "\n",
        "print(\n",
        "    \"\\nTraining reverse diffusion network...\\n\"\n",
        ")\n",
        "\n",
        "# =========================================================\n",
        "# TRAINING LOOP\n",
        "# =========================================================\n",
        "\n",
        "for epoch in range(EPOCHS):\n",
        "\n",
        "    total_loss = 0.0\n",
        "\n",
        "    denoising_model.train()\n",
        "\n",
        "    for (\n",
        "\n",
        "        x0_batch,\n",
        "\n",
        "        confidence_batch,\n",
        "\n",
        "        target_idx_batch\n",
        "\n",
        "    ) in loader:\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # move to device\n",
        "        # -----------------------------------------\n",
        "\n",
        "        x0_batch = x0_batch.to(device)\n",
        "\n",
        "        confidence_batch = confidence_batch.to(device)\n",
        "\n",
        "        target_idx_batch = target_idx_batch.to(device)\n",
        "\n",
        "        batch_size = x0_batch.size(0)\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # target context embeddings\n",
        "        # -----------------------------------------\n",
        "\n",
        "        target_context = movie_tensor[\n",
        "            target_idx_batch\n",
        "        ]\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # random timestep\n",
        "        # -----------------------------------------\n",
        "\n",
        "        t = np.random.randint(\n",
        "\n",
        "            0,\n",
        "\n",
        "            T\n",
        "\n",
        "        )\n",
        "\n",
        "        timestep_tensor = torch.full(\n",
        "\n",
        "            (batch_size,),\n",
        "\n",
        "            t / T,\n",
        "\n",
        "            dtype=torch.float32,\n",
        "\n",
        "            device=device\n",
        "\n",
        "        )\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # forward diffusion\n",
        "        # -----------------------------------------\n",
        "\n",
        "        z_t, noise = (\n",
        "\n",
        "            confidence_gated_forward_diffusion(\n",
        "\n",
        "                x0_batch,\n",
        "\n",
        "                confidence_batch,\n",
        "\n",
        "                t\n",
        "\n",
        "            )\n",
        "\n",
        "        )\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # reverse diffusion\n",
        "        # -----------------------------------------\n",
        "\n",
        "        reconstructed_embedding = (\n",
        "\n",
        "            denoising_model(\n",
        "\n",
        "                z_t,\n",
        "\n",
        "                confidence_batch,\n",
        "\n",
        "                target_context,\n",
        "\n",
        "                timestep_tensor\n",
        "\n",
        "            )\n",
        "\n",
        "        )\n",
        "\n",
        "        # =================================================\n",
        "        # LOSS 1 — RECONSTRUCTION LOSS\n",
        "        # =================================================\n",
        "\n",
        "        reconstruction_loss = criterion(\n",
        "\n",
        "            reconstructed_embedding,\n",
        "\n",
        "            x0_batch\n",
        "\n",
        "        )\n",
        "\n",
        "        # =================================================\n",
        "        # LOSS 2 — TARGET ALIGNMENT LOSS\n",
        "        # =================================================\n",
        "\n",
        "        alignment_loss = (\n",
        "\n",
        "            1\n",
        "\n",
        "            -\n",
        "\n",
        "            torch.mean(\n",
        "\n",
        "                nn.functional.cosine_similarity(\n",
        "\n",
        "                    reconstructed_embedding,\n",
        "\n",
        "                    target_context,\n",
        "\n",
        "                    dim=1\n",
        "\n",
        "                )\n",
        "\n",
        "            )\n",
        "\n",
        "        )\n",
        "\n",
        "        # =================================================\n",
        "        # LOSS 3 — CONFIDENCE REGULARIZATION\n",
        "        # =================================================\n",
        "\n",
        "        confidence_regularization = torch.mean(\n",
        "\n",
        "            (\n",
        "\n",
        "                confidence_batch\n",
        "\n",
        "                -\n",
        "\n",
        "                0.5\n",
        "\n",
        "            ) ** 2\n",
        "\n",
        "        )\n",
        "\n",
        "        # =================================================\n",
        "        # TOTAL LOSS\n",
        "        # =================================================\n",
        "\n",
        "        loss = (\n",
        "\n",
        "            reconstruction_loss\n",
        "\n",
        "            +\n",
        "\n",
        "            0.30 * alignment_loss\n",
        "\n",
        "            +\n",
        "\n",
        "            0.05 * confidence_regularization\n",
        "\n",
        "        )\n",
        "\n",
        "        # =================================================\n",
        "        # OPTIMIZATION\n",
        "        # =================================================\n",
        "\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        loss.backward()\n",
        "\n",
        "        optimizer.step()\n",
        "\n",
        "        total_loss += loss.item()\n",
        "\n",
        "    # =====================================================\n",
        "    # EPOCH LOG\n",
        "    # =====================================================\n",
        "\n",
        "    average_loss = (\n",
        "\n",
        "        total_loss\n",
        "\n",
        "        /\n",
        "\n",
        "        len(loader)\n",
        "\n",
        "    )\n",
        "\n",
        "    print(\n",
        "\n",
        "        f\"Epoch {epoch+1}/{EPOCHS}\"\n",
        "\n",
        "        f\" | Avg Loss: {average_loss:.6f}\"\n",
        "\n",
        "    )\n",
        "\n",
        "print(\n",
        "    \"\\nReverse diffusion training completed!\"\n",
        ")\n"
      ]
    },
