      ],
      "source": [
        "# =========================================================\n",
        "# STEP 15 — RANKING EVALUATION\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Evaluate:\n",
        "\n",
        "1. NDCG@K\n",
        "2. Hit Ratio@K\n",
        "3. MRR\n",
        "\n",
        "Goal:\n",
        "\n",
        "Measure ranking quality of\n",
        "cross-domain recommendations.\n",
        "\"\"\"\n",
        "\n",
        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "import numpy as np\n",
        "from tqdm import tqdm\n",
        "\n",
        "def ndcg_at_k(\n",
        "\n",
        "    ranked_items,\n",
        "\n",
        "    ground_truth_item,\n",
        "\n",
        "    k=10\n",
        "\n",
        "):\n",
        "\n",
        "    ranked_items = ranked_items[:k]\n",
        "\n",
        "    for rank, item in enumerate(ranked_items):\n",
        "\n",
        "        if item == ground_truth_item:\n",
        "\n",
        "            return 1.0 / np.log2(rank + 2)\n",
        "\n",
        "    return 0.0\n",
        "\n",
        "\n",
        "def hit_ratio_at_k(\n",
        "\n",
        "    ranked_items,\n",
        "\n",
        "    ground_truth_item,\n",
        "\n",
        "    k=10\n",
        "\n",
        "):\n",
        "\n",
        "    ranked_items = ranked_items[:k]\n",
        "\n",
        "    return int(\n",
        "\n",
        "        ground_truth_item\n",
        "\n",
        "        in\n",
        "\n",
        "        ranked_items\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "def mrr_score(\n",
        "\n",
        "    ranked_items,\n",
        "\n",
        "    ground_truth_item\n",
        "\n",
        "):\n",
        "\n",
        "    for rank, item in enumerate(\n",
        "\n",
        "        ranked_items\n",
        "\n",
        "    ):\n",
        "\n",
        "        if item == ground_truth_item:\n",
        "\n",
        "            return 1.0 / (rank + 1)\n",
        "\n",
        "    return 0.0\n",
        "\n",
        "# =========================================================\n",
        "# EVALUATION LOOP\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nEvaluating recommendation quality...\\n\")\n",
        "\n",
        "NDCG_scores = []\n",
        "\n",
        "HR_scores = []\n",
        "\n",
        "MRR_scores = []\n",
        "\n",
        "for i in range(\n",
        "\n",
        "    len(final_transferred_embeddings)\n",
        "\n",
        "):\n",
        "\n",
        "    scores = np.dot(\n",
        "\n",
        "        movie_embeddings,\n",
        "\n",
        "        final_transferred_embeddings[i]\n",
        "\n",
        "    )\n",
        "\n",
        "    ranked_items = np.argsort(\n",
        "\n",
        "        scores\n",
        "\n",
        "    )[::-1]\n",
        "\n",
        "    ground_truth_item = (\n",
        "\n",
        "        ground_truth_items[i]\n",
        "\n",
        "    )\n",
        "\n",
        "    ndcg = ndcg_at_k(\n",
        "\n",
        "        ranked_items,\n",
        "\n",
        "        ground_truth_item,\n",
        "\n",
        "        k=10\n",
        "\n",
        "    )\n",
        "\n",
        "    hr = hit_ratio_at_k(\n",
        "\n",
        "        ranked_items,\n",
        "\n",
        "        ground_truth_item,\n",
        "\n",
        "        k=10\n",
        "\n",
        "    )\n",
        "\n",
        "    mrr = mrr_score(\n",
        "\n",
        "        ranked_items,\n",
        "\n",
        "        ground_truth_item\n",
        "\n",
        "    )\n",
        "\n",
        "    NDCG_scores.append(ndcg)\n",
        "\n",
        "    HR_scores.append(hr)\n",
        "\n",
        "    MRR_scores.append(mrr)\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"FINAL RANKING PERFORMANCE\")\n",
        "\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\n",
        "\n",
        "    f\"NDCG@10      : \"\n",
        "\n",
        "    f\"{np.mean(NDCG_scores):.4f}\"\n",
        "\n",
        ")\n",
        "\n",
        "print(\n",
        "\n",
        "    f\"Hit Ratio@10 : \"\n",
        "\n",
        "    f\"{np.mean(HR_scores):.4f}\"\n",
        "\n",
        ")\n",
        "\n",
        "print(\n",
        "\n",
        "    f\"MRR          : \"\n",
        "\n",
        "    f\"{np.mean(MRR_scores):.4f}\"\n",
        "\n",
        ")\n",
        "\n",
        "print(\"=\" * 70)"
      ]
    }
