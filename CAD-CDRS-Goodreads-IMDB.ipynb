      "source": [
        "# =========================================================\n",
        "# STEP 7.8 — WEIGHTED MULTI-SIGNAL CONFIDENCE AGGREGATION\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Weighted Confidence Aggregation\n",
        "\n",
        "Final Confidence Equation:\n",
        "\n",
        "c_u =\n",
        "\n",
        "w1*c1\n",
        "+\n",
        "w2*c2\n",
        "+\n",
        "w3*c3\n",
        "+\n",
        "w4*c4\n",
        "+\n",
        "w5*c5\n",
        "\n",
        "where:\n",
        "\n",
        "c1 → interaction overlap confidence\n",
        "c2 → preference stability confidence\n",
        "c3 → embedding alignment confidence\n",
        "c4 → genre domain-gap confidence\n",
        "c5 → item-level similarity confidence\n",
        "\n",
        "Goal:\n",
        "\n",
        "Fuse multiple confidence signals\n",
        "into one robust transfer confidence score.\n",
        "\"\"\"\n",
        "\n",
        "print(\"\\nComputing weighted confidence scores...\\n\")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# CONFIDENCE WEIGHTS\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Recommended weighting strategy:\n",
        "\n",
        "Higher weights:\n",
        "    stronger semantic transfer signals\n",
        "\n",
        "Lower weights:\n",
        "    auxiliary behavioral signals\n",
        "\"\"\"\n",
        "\n",
        "WEIGHT_INTERACTION      = 0.20\n",
        "\n",
        "WEIGHT_ENTROPY         = 0.15\n",
        "\n",
        "WEIGHT_EMBEDDING       = 0.25\n",
        "\n",
        "WEIGHT_GENRE_DISTANCE  = 0.15\n",
        "\n",
        "WEIGHT_ITEM_SIMILARITY = 0.25\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# EXTRACT CONFIDENCE SIGNALS\n",
        "# =========================================================\n",
        "\n",
        "c1 = confidence_features[:, 0]\n",
        "\n",
        "c2 = confidence_features[:, 1]\n",
        "\n",
        "c3 = confidence_features[:, 2]\n",
        "\n",
        "c4 = confidence_features[:, 3]\n",
        "\n",
        "c5 = confidence_features[:, 4]\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# WEIGHTED CONFIDENCE AGGREGATION\n",
        "# =========================================================\n",
        "\n",
        "final_confidence_scores = (\n",
        "\n",
        "    WEIGHT_INTERACTION\n",
        "    *\n",
        "    c1\n",
        "\n",
        "    +\n",
        "\n",
        "    WEIGHT_ENTROPY\n",
        "    *\n",
        "    c2\n",
        "\n",
        "    +\n",
        "\n",
        "    WEIGHT_EMBEDDING\n",
        "    *\n",
        "    c3\n",
        "\n",
        "    +\n",
        "\n",
        "    WEIGHT_GENRE_DISTANCE\n",
        "    *\n",
        "    c4\n",
        "\n",
        "    +\n",
        "\n",
        "    WEIGHT_ITEM_SIMILARITY\n",
        "    *\n",
        "    c5\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# NORMALIZE CONFIDENCE SCORES\n",
        "# =========================================================\n",
        "\n",
        "final_confidence_scores = np.clip(\n",
        "\n",
        "    final_confidence_scores,\n",
        "\n",
        "    0.0,\n",
        "\n",
        "    1.0\n",
        "\n",
        ").astype(np.float32)\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# DISPLAY STATISTICS\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nConfidence aggregation completed!\")\n",
        "\n",
        "print(\n",
        "    f\"\\nConfidence Shape : \"\n",
        "    f\"{final_confidence_scores.shape}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Minimum Confidence : \"\n",
        "    f\"{final_confidence_scores.min():.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Maximum Confidence : \"\n",
        "    f\"{final_confidence_scores.max():.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Average Confidence : \"\n",
        "    f\"{final_confidence_scores.mean():.4f}\"\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# OPTIONAL — DISPLAY SAMPLE SCORES\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nSample Confidence Scores:\\n\")\n",
        "\n",
        "for i in range(5):\n",
        "\n",
