          "text": [
            "\n",
            "Evaluating recommendation quality...\n",
            "\n",
            "\n",
            "\n",
            "======================================================================\n",
            "FINAL RANKING PERFORMANCE\n",
            "======================================================================\n",
            "NDCG@10      : 0.0072\n",
            "Hit Ratio@10 : 0.0093\n",
            "MRR          : 0.0086\n",
            "======================================================================\n"
          ]
