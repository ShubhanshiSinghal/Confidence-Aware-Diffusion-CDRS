      "source": [
        "# =========================================================\n",
        "# STEP 8.6 — TARGET-GUIDED MULTI-STEP DENOISING\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nGenerating denoised embeddings...\\n\")\n",
        "\n",
        "denoised_embeddings = []\n",
        "\n",
        "denoising_model.eval()\n",
        "\n",
        "with torch.no_grad():\n",
        "\n",
        "    for i in tqdm(\n",
        "\n",
        "        range(len(book_tensor)),\n",
        "\n",
        "        desc=\"Denoising\"\n",
        "\n",
        "    ):\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # source embedding\n",
        "        # -----------------------------------------\n",
        "\n",
        "        x0 = book_tensor[\n",
        "            i\n",
        "        ].unsqueeze(0)\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # confidence score\n",
        "        # -----------------------------------------\n",
        "\n",
        "        confidence = confidence_tensor[\n",
        "            i\n",
        "        ].unsqueeze(0)\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # target context\n",
        "        #\n",
        "        # reuse Step 8.5\n",
        "        # precomputed matches\n",
        "        # -----------------------------------------\n",
        "\n",
        "        movie_idx = best_movie_indices[i]\n",
        "\n",
        "        target_context = movie_tensor[\n",
        "            movie_idx\n",
        "        ].unsqueeze(0)\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # initialize noisy embedding\n",
        "        # -----------------------------------------\n",
        "\n",
        "        z_t, _ = (\n",
        "\n",
        "            confidence_gated_forward_diffusion(\n",
        "\n",
        "                x0,\n",
        "\n",
        "                confidence,\n",
        "\n",
        "                T - 1\n",
        "\n",
        "            )\n",
        "\n",
        "        )\n",
        "\n",
        "        # =================================================\n",
        "        # MULTI-STEP REVERSE DIFFUSION\n",
        "        # =================================================\n",
        "\n",
        "        for t in reversed(range(T)):\n",
        "\n",
        "            timestep_tensor = torch.full(\n",
        "\n",
        "                (1,),\n",
        "\n",
        "                t / T,\n",
        "\n",
        "                dtype=torch.float32,\n",
        "\n",
        "                device=device\n",
        "\n",
        "            )\n",
        "\n",
        "            # -----------------------------------------\n",
        "            # reconstruct clean embedding\n",
        "            # -----------------------------------------\n",
        "\n",
        "            reconstructed_embedding = (\n",
        "\n",
        "                denoising_model(\n",
        "\n",
        "                    z_t,\n",
        "\n",
        "                    confidence,\n",
        "\n",
        "                    target_context,\n",
        "\n",
        "                    timestep_tensor\n",
        "\n",
        "                )\n",
        "\n",
        "            )\n",
        "\n",
        "            # -----------------------------------------\n",
        "            # diffusion coefficient\n",
        "            # -----------------------------------------\n",
        "\n",
        "            alpha_t = alpha_schedule[t]\n",
        "\n",
        "            alpha_t = torch.clamp(\n",
        "\n",
        "                alpha_t,\n",
        "\n",
        "                min=1e-5,\n",
        "\n",
        "                max=0.9999\n",
        "\n",
        "            )\n",
        "\n",
        "            # -----------------------------------------\n",
        "            # confidence-guided reverse update\n",
        "            # -----------------------------------------\n",
        "\n",
        "            z_t = (\n",
        "\n",
        "                confidence\n",
        "                *\n",
        "                reconstructed_embedding\n",
        "\n",
        "                +\n",
        "\n",
        "                (1 - confidence)\n",
        "                *\n",
        "                target_context\n",
        "\n",
        "            )\n",
        "\n",
        "            # -----------------------------------------\n",
        "            # timestep smoothing\n",
        "            # -----------------------------------------\n",
        "\n",
        "            z_t = (\n",
        "\n",
        "                torch.sqrt(alpha_t)\n",
        "                *\n",
        "                z_t\n",
        "\n",
        "                +\n",
        "\n",
        "                torch.sqrt(\n",
        "                    1 - alpha_t\n",
        "                )\n",
        "                *\n",
        "                target_context\n",
        "\n",
        "            )\n",
        "\n",
        "        # =================================================\n",
        "        # FINAL STABILIZATION\n",
        "        # =================================================\n",
        "\n",
        "        final_embedding = (\n",
        "\n",
        "            0.70 * x0\n",
        "\n",
        "            +\n",
        "\n",
        "            0.30 * z_t\n",
        "\n",
        "        )\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # clamp for stability\n",
        "        # -----------------------------------------\n",
        "\n",
        "        final_embedding = torch.clamp(\n",
        "\n",
        "            final_embedding,\n",
        "\n",
        "            -3.0,\n",
        "\n",
        "            3.0\n",
        "\n",
        "        )\n",
        "\n",
        "        denoised_embeddings.append(\n",
        "\n",
        "            final_embedding\n",
        "            .cpu()\n",
        "            .numpy()[0]\n",
        "\n",
        "        )\n",
        "\n",
        "# =========================================================\n",
        "# CONVERT TO NUMPY\n",
        "# =========================================================\n",
        "\n",
        "denoised_embeddings = np.asarray(\n",
        "\n",
        "    denoised_embeddings,\n",
        "\n",
        "    dtype=np.float32\n",
        "\n",
        ")\n",
        "\n",
        "# =========================================================\n",
        "# NORMALIZATION\n",
        "# =========================================================\n",
        "\n",
        "denoised_embeddings = normalize(\n",
        "    denoised_embeddings\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\nTarget-guided denoised embeddings generated!\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Denoised Embedding Shape : \"\n",
        "    f\"{denoised_embeddings.shape}\"\n",
        ")"
      ]
