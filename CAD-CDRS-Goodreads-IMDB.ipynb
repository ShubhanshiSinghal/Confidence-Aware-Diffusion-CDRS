      "source": [
        "# =========================================================\n",
        "# STEP 11 — ALIGNMENT / RECONSTRUCTION LOSS\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Alignment Reconstruction Loss\n",
        "\n",
        "Equation:\n",
        "\n",
        "L_align\n",
        "\n",
        "=\n",
        "|| e_u^S - e_u^T ||²\n",
        "\n",
        "where:\n",
        "\n",
        "e_u^S\n",
        "=\n",
        "source-domain embedding\n",
        "\n",
        "e_u^T\n",
        "=\n",
        "transferred target-domain embedding\n",
        "\n",
        "Goal:\n",
        "\n",
        "Ensure transferred embeddings:\n",
        "\n",
        "✔ preserve source semantics\n",
        "✔ remain numerically stable\n",
        "✔ avoid excessive drift\n",
        "✔ maintain cross-domain consistency\n",
        "\n",
        "Interpretation:\n",
        "\n",
        "Small loss\n",
        "=\n",
        "better alignment\n",
        "\n",
        "Large loss\n",
        "=\n",
        "poor transfer consistency\n",
        "\"\"\"\n",
        "\n",
        "import torch.nn.functional as F\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 11.1 — CONVERT EMBEDDINGS TO TENSORS\n",
        "# =========================================================\n",
        "\n",
        "source_embedding_tensor = torch.tensor(\n",
        "\n",
        "    book_embeddings,\n",
        "\n",
        "    dtype=torch.float32\n",
        "\n",
        ").to(device)\n",
        "\n",
        "\n",
        "transferred_embedding_tensor = torch.tensor(\n",
        "\n",
        "    final_transferred_embeddings,\n",
        "\n",
        "    dtype=torch.float32\n",
        "\n",
        ").to(device)\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 11.2 — ALIGNMENT LOSS FUNCTION\n",
        "# =========================================================\n",
        "\n",
        "def alignment_loss(\n",
        "\n",
        "    source_embedding,\n",
        "\n",
        "    transferred_embedding\n",
        "\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    L_align\n",
        "\n",
        "    =\n",
        "    || e_u^S - e_u^T ||²\n",
        "    \"\"\"\n",
        "\n",
        "    loss = torch.mean(\n",
        "\n",
        "        torch.sum(\n",
        "\n",
        "            (\n",
        "\n",
        "                source_embedding\n",
        "                -\n",
        "                transferred_embedding\n",
        "\n",
        "            ) ** 2,\n",
        "\n",
        "            dim=1\n",
        "\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "    return loss\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 11.3 — COMPUTE ALIGNMENT LOSS\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nComputing alignment reconstruction loss...\\n\")\n",
        "\n",
        "L_align = alignment_loss(\n",
        "\n",
        "    source_embedding_tensor,\n",
        "\n",
        "    transferred_embedding_tensor\n",
        "\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"L_align = {L_align.item():.6f}\"\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 11.4 — OPTIONAL JOINT OBJECTIVE\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Combined Objective\n",
        "\n",
        "L_total\n",
        "\n",
        "=\n",
        "L_BPR\n",
        "+\n",
        "lambda_align * L_align\n",
        "\n",
        "Goal:\n",
        "\n",
        "✔ optimize ranking quality\n",
        "✔ preserve semantic consistency\n",
        "✔ stabilize transfer learning\n",
        "\"\"\"\n",
        "\n",
        "lambda_align = 0.1\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# EXAMPLE TOTAL LOSS\n",
        "# =========================================================\n",
        "\n",
        "example_total_loss = (\n",
        "\n",
        "    loss\n",
        "    +\n",
        "    lambda_align * L_align\n",
        "\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"\\nCombined Objective Loss : \"\n",
        "    f\"{example_total_loss.item():.6f}\"\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 11.5 — DISPLAY INTERPRETATION\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nAlignment Loss Interpretation:\")\n",
        "\n",
        "print(\n",
        "    \"\\nLower L_align → \"\n",
        "    \"better cross-domain consistency\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Higher L_align → \"\n",
        "    \"larger semantic transfer gap\"\n",
        ")"
      ]
