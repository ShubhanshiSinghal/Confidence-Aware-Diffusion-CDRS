        "# =========================================================\n",
        "# STEP 12 — CONFIDENCE REGULARIZATION\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Confidence-Regularized Objective\n",
        "\n",
        "Full Objective:\n",
        "\n",
        "L\n",
        "\n",
        "=\n",
        "L_BPR\n",
        "+\n",
        "lambda1 * L_align\n",
        "+\n",
        "lambda2 * L_rec\n",
        "\n",
        "where:\n",
        "\n",
        "L_BPR\n",
        "=\n",
        "ranking optimization loss\n",
        "\n",
        "L_align\n",
        "=\n",
        "cross-domain alignment loss\n",
        "\n",
        "L_rec\n",
        "=\n",
        "confidence regularization loss\n",
        "\n",
        "Goal:\n",
        "\n",
        "✔ stabilize confidence learning\n",
        "✔ avoid extreme confidence values\n",
        "✔ prevent overconfident transfer\n",
        "✔ improve generalization\n",
        "✔ reduce noisy diffusion behavior\n",
        "\n",
        "Interpretation:\n",
        "\n",
        "Very high confidence:\n",
        "    may cause over-transfer\n",
        "\n",
        "Very low confidence:\n",
        "    weak transfer learning\n",
        "\n",
        "Regularization keeps confidence\n",
        "within stable operating range.\n",
        "\"\"\"\n",
        "\n",
        "import torch.nn.functional as F\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 12.1 — CONFIDENCE TENSOR\n",
        "# =========================================================\n",
        "\n",
        "confidence_regularization_tensor = torch.tensor(\n",
        "\n",
        "    final_confidence_scores,\n",
        "\n",
        "    dtype=torch.float32\n",
        "\n",
        ").unsqueeze(1).to(device)\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 12.2 — CONFIDENCE REGULARIZATION LOSS\n",
        "# =========================================================\n",
        "\n",
        "def confidence_regularization_loss(\n",
        "\n",
        "    confidence_scores,\n",
        "\n",
        "    target_mean=0.5\n",
        "\n",
        "):\n",
        "\n",
        "    \"\"\"\n",
        "    Confidence Regularization\n",
        "\n",
        "    Penalizes extreme confidence values.\n",
        "\n",
        "    Goal:\n",
        "\n",
        "    keep confidence distribution stable\n",
        "    \"\"\"\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # mean confidence\n",
        "    # -----------------------------------------\n",
        "\n",
        "    confidence_mean = torch.mean(\n",
        "        confidence_scores\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # variance regularization\n",
        "    # -----------------------------------------\n",
        "\n",
        "    confidence_variance = torch.var(\n",
        "        confidence_scores\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # mean stabilization\n",
        "    # -----------------------------------------\n",
        "\n",
        "    mean_loss = (\n",
        "\n",
        "        confidence_mean\n",
        "        -\n",
        "        target_mean\n",
        "\n",
        "    ) ** 2\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # entropy-inspired stabilization\n",
        "    # -----------------------------------------\n",
        "\n",
        "    variance_loss = 1.0 / (\n",
        "\n",
        "        confidence_variance\n",
        "        + 1e-6\n",
        "\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # total regularization\n",
        "    # -----------------------------------------\n",
        "\n",
        "    regularization_loss = (\n",
        "\n",
        "        mean_loss\n",
        "        +\n",
        "        0.001 * variance_loss\n",
        "\n",
        "    )\n",
        "\n",
        "    return regularization_loss\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 12.3 — COMPUTE REGULARIZATION LOSS\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nComputing confidence regularization...\\n\")\n",
        "\n",
        "L_rec = confidence_regularization_loss(\n",
        "\n",
        "    confidence_regularization_tensor\n",
        "\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"L_rec = {L_rec.item():.6f}\"\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 12.4 — FULL OBJECTIVE FUNCTION\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Final Objective:\n",
        "\n",
        "L\n",
        "\n",
        "=\n",
        "L_BPR\n",
        "+\n",
        "lambda1 * L_align\n",
        "+\n",
        "lambda2 * L_rec\n",
        "\"\"\"\n",
        "\n",
        "lambda1 = 0.10\n",
        "\n",
        "lambda2 = 0.05\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# COMPUTE TOTAL LOSS\n",
        "# =========================================================\n",
        "\n",
        "L_total = (\n",
        "\n",
        "    loss\n",
        "\n",
        "    +\n",
        "\n",
        "    lambda1 * L_align\n",
        "\n",
        "    +\n",
        "\n",
        "    lambda2 * L_rec\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# DISPLAY FINAL OBJECTIVE\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nFinal Objective Components:\\n\")\n",
        "\n",
        "print(\n",
        "    f\"L_BPR   : {loss.item():.6f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"L_align : {L_align.item():.6f}\"\n",
        ")\n",
