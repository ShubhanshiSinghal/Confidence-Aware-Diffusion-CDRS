        "    )\n",
        "\n",
        "    print(\n",
        "        f\"c5 Item Similarity       : \"\n",
        "        f\"{c5[i]:.4f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Final Confidence         : \"\n",
        "        f\"{final_confidence_scores[i]:.4f}\"\n",
        "    )\n",
        "\n",
        "    print(\"=\" * 60)"
      ]
