      "source": [
        "# =========================================================\n",
        "# STEP 8.7 — FINAL TRANSFERRED EMBEDDING (GATED FUSION)\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Final Transferred Embedding\n",
        "\n",
        "ê_u\n",
        "\n",
        "=\n",
        "(1 - c_(u,i)) * e_u^T\n",
        "\n",
        "+\n",
        "\n",
        "c_(u,i) * z_(u,i)^(0)\n",
        "\n",
        "where\n",
        "\n",
        "e_u^T\n",
        "=\n",
        "target-domain context embedding\n",
        "\n",
        "z_(u,i)^(0)\n",
        "=\n",
        "denoised transferred embedding\n",
        "\n",
        "c_(u,i)\n",
        "=\n",
        "confidence score\n",
        "\"\"\"\n",
        "\n",
        "print(\n",
        "    \"\\nGenerating gated-fusion transferred embeddings...\\n\"\n",
        ")\n",
        "\n",
        "# =========================================================\n",
        "# MOVIE TENSOR\n",
        "# =========================================================\n",
        "\n",
        "movie_tensor = torch.tensor(\n",
        "\n",
        "    movie_embeddings,\n",
        "\n",
        "    dtype=torch.float32,\n",
        "\n",
        "    device=device\n",
        "\n",
        ")\n",
        "\n",
        "# =========================================================\n",
        "# CREATE FINAL TRANSFERRED EMBEDDINGS\n",
        "# =========================================================\n",
        "\n",
        "final_transferred_embeddings = []\n",
        "\n",
        "with torch.no_grad():\n",
        "\n",
        "    for i in tqdm(\n",
        "\n",
        "        range(len(book_tensor)),\n",
        "\n",
        "        desc=\"Gated Fusion\"\n",
        "\n",
        "    ):\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # denoised embedding\n",
        "        # -----------------------------------------\n",
        "\n",
        "        transferred_embedding = torch.tensor(\n",
        "\n",
        "            denoised_embeddings[i],\n",
        "\n",
        "            dtype=torch.float32,\n",
        "\n",
        "            device=device\n",
        "\n",
        "        ).unsqueeze(0)\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # reuse target context from Step 8.5\n",
        "        # -----------------------------------------\n",
        "\n",
        "        movie_idx = best_movie_indices[i]\n",
        "\n",
        "        target_embedding = movie_tensor[\n",
        "            movie_idx\n",
        "        ].unsqueeze(0)\n",
        "\n",
        "        # -----------------------------------------\n",
        "        # confidence\n",
        "        # -----------------------------------------\n",
        "\n",
        "        confidence = confidence_tensor[\n",
        "            i\n",
        "        ].unsqueeze(0)\n",
        "\n",
        "        # =================================================\n",
        "        # GATED FUSION\n",
        "        # =================================================\n",
        "\n",
        "        final_embedding = (\n",
        "\n",
        "            (1.0 - confidence)\n",
        "            *\n",
        "            target_embedding\n",
        "\n",
        "            +\n",
        "\n",
        "            confidence\n",
        "            *\n",
        "            transferred_embedding\n",
        "\n",
        "        )\n",
        "\n",
        "        # =================================================\n",
        "        # RESIDUAL STABILIZATION\n",
        "        # =================================================\n",
        "\n",
        "        final_embedding = (\n",
        "\n",
        "            0.80\n",
        "            *\n",
        "            final_embedding\n",
        "\n",
        "            +\n",
        "\n",
        "            0.20\n",
        "            *\n",
        "            target_embedding\n",
        "\n",
        "        )\n",
        "\n",
        "        final_transferred_embeddings.append(\n",
        "\n",
        "            final_embedding\n",
        "            .cpu()\n",
        "            .numpy()[0]\n",
        "\n",
        "        )\n",
        "\n",
        "# =========================================================\n",
        "# CONVERT TO NUMPY\n",
        "# =========================================================\n",
        "\n",
        "final_transferred_embeddings = np.asarray(\n",
        "\n",
        "    final_transferred_embeddings,\n",
        "\n",
        "    dtype=np.float32\n",
        "\n",
        ")\n",
        "\n",
        "# =========================================================\n",
        "# NORMALIZE\n",
        "# =========================================================\n",
        "\n",
        "final_transferred_embeddings = normalize(\n",
        "\n",
        "    final_transferred_embeddings\n",
        "\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\nGated-fusion transferred embeddings created!\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Transferred Embedding Shape : \"\n",
        "    f\"{final_transferred_embeddings.shape}\"\n",
        ")\n",
        "\n",
        "\n",
        "del denoised_embeddings\n",
        "\n",
        "import gc\n",
        "gc.collect()\n",
        "\n",
        "torch.cuda.empty_cache()"
      ]
