        "# =========================================================\n",
        "# STEP 6 — SENTENCE EMBEDDING FUNCTION\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Sentence Embedding Generation\n",
        "\n",
        "Embedding Strategy:\n",
        "- tokenize text\n",
        "- retrieve GloVe vectors\n",
        "- average valid word vectors\n",
        "\n",
        "Enhancements:\n",
        "✔ robust type handling\n",
        "✔ empty-text protection\n",
        "✔ OOV handling\n",
        "✔ float32 optimization\n",
        "✔ faster execution\n",
        "\"\"\"\n",
        "\n",
        "from tqdm import tqdm\n",
        "\n",
        "\n",
        "def sentence_embedding(text):\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # null protection\n",
        "    # -----------------------------------------\n",
        "\n",
        "    if pd.isna(text):\n",
        "\n",
        "        return np.zeros(\n",
        "            EMBEDDING_DIM,\n",
        "            dtype=np.float32\n",
        "        )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # string conversion\n",
        "    # -----------------------------------------\n",
        "\n",
        "    text = str(text).strip().lower()\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # empty protection\n",
        "    # -----------------------------------------\n",
        "\n",
        "    if len(text) == 0:\n",
        "\n",
        "        return np.zeros(\n",
        "            EMBEDDING_DIM,\n",
        "            dtype=np.float32\n",
        "        )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # tokenization\n",
        "    # -----------------------------------------\n",
        "\n",
        "    words = text.split()\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # collect valid glove vectors\n",
        "    # -----------------------------------------\n",
        "\n",
        "    vectors = [\n",
        "\n",
        "        embeddings_index[word]\n",
        "\n",
        "        for word in words\n",
        "\n",
        "        if word in embeddings_index\n",
        "\n",
        "    ]\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # no valid vectors\n",
        "    # -----------------------------------------\n",
        "\n",
        "    if len(vectors) == 0:\n",
        "\n",
        "        return np.zeros(\n",
        "            EMBEDDING_DIM,\n",
        "            dtype=np.float32\n",
        "        )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # convert to numpy\n",
        "    # -----------------------------------------\n",
        "\n",
        "    vectors = np.asarray(\n",
        "        vectors,\n",
        "        dtype=np.float32\n",
        "    )\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # mean pooling\n",
        "    # -----------------------------------------\n",
        "\n",
        "    sentence_vector = np.mean(\n",
        "        vectors,\n",
        "        axis=0\n",
        "    )\n",
        "\n",
        "    return sentence_vector.astype(\n",
        "        np.float32\n",
        "    )\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# STEP 6 — GENERATE EMBEDDINGS\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Generate semantic embeddings\n",
        "for books and movies.\n",
        "\"\"\"\n",
        "\n",
        "print(\"\\nGenerating Book Embeddings...\\n\")\n",
        "\n",
        "book_embeddings = np.asarray(\n",
        "\n",
        "    [\n",
        "\n",
        "        sentence_embedding(text)\n",
        "\n",
        "        for text in tqdm(\n",
        "            books['combined_text'],\n",
        "            desc=\"Books\"\n",
        "        )\n",
        "\n",
        "    ],\n",
        "\n",
        "    dtype=np.float32\n",
        "\n",
        ")\n",
        "\n",
        "print(\"\\nGenerating Movie Embeddings...\\n\")\n",
        "\n",
        "movie_embeddings = np.asarray(\n",
        "\n",
        "    [\n",
        "\n",
        "        sentence_embedding(text)\n",
        "\n",
        "        for text in tqdm(\n",
        "            movies['combined_text'],\n",
        "            desc=\"Movies\"\n",
        "        )\n",
        "\n",
        "    ],\n",
        "\n",
        "    dtype=np.float32\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# VALIDATION CHECKS\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nEmbedding generation completed!\")\n",
        "\n",
        "print(\n",
        "    f\"Book Embeddings Shape  : \"\n",
        "    f\"{book_embeddings.shape}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Movie Embeddings Shape : \"\n",
        "    f\"{movie_embeddings.shape}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Embedding Dimension    : \"\n",
        "    f\"{EMBEDDING_DIM}\"\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# PRESERVE ORIGINAL EMBEDDINGS\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Preserve original embeddings\n",
        "before normalization,\n",
        "diffusion,\n",
        "or transfer learning.\n",
        "\"\"\"\n",
        "\n",
        "original_book_embeddings = (\n",
        "    book_embeddings.copy()\n",
        ")\n",
        "\n",
        "original_movie_embeddings = (\n",
        "    movie_embeddings.copy()\n",
        ")\n",
        "\n",
        "print(\"\\nOriginal embeddings preserved!\")\n",
        "\n",
        "print(\n",
        "    f\"Original Book Embeddings  : \"\n",
        "    f\"{original_book_embeddings.shape}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Original Movie Embeddings : \"\n",
        "    f\"{original_movie_embeddings.shape}\"\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# OPTIONAL MEMORY OPTIMIZATION\n",
        "# =========================================================\n",
        "\n",
        "\"\"\"\n",
        "Reduce RAM usage\n",
        "for large datasets.\n",
        "\"\"\"\n",
        "\n",
        "book_embeddings = book_embeddings.astype(\n",
        "    np.float32\n",
        ")\n",
        "\n",
        "movie_embeddings = movie_embeddings.astype(\n",
        "    np.float32\n",
        ")\n",
        "\n",
        "original_book_embeddings = (\n",
        "    original_book_embeddings.astype(\n",
        "        np.float32\n",
        "    )\n",
        ")\n",
        "\n",
        "original_movie_embeddings = (\n",
        "    original_movie_embeddings.astype(\n",
        "        np.float32\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\nMemory optimization completed!\")\n",
        "\n",
        "# =========================================================\n",
        "# PRESERVE ORIGINAL EMBEDDINGS\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nPreserving original embeddings...\\n\")\n",
        "\n",
        "original_book_embeddings = (\n",
        "    book_embeddings.copy()\n",
        ").astype(np.float32)\n",
        "\n",
        "original_movie_embeddings = (\n",
        "    movie_embeddings.copy()\n",
        ").astype(np.float32)\n",
        "\n",
        "print(\n",
        "    \"Original embeddings preserved!\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Original Book Shape  : \"\n",
        "    f\"{original_book_embeddings.shape}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Original Movie Shape : \"\n",
        "    f\"{original_movie_embeddings.shape}\"\n",
        ")"
      ]
